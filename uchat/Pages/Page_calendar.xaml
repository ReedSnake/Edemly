<Page x:Class="uchat.Page_calendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:uchat"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Page_calendar">

    <Page.Resources>
        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F6FFFC"/>
            <Setter Property="Foreground" Value="#0B4539"/>
            <Setter Property="BorderBrush" Value="#C3F0E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0F7F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#F6FFFC"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#C3F0E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ColorRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Rounded button style for AddTaskPanel buttons -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0B4539"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary rounded style (outline) -->
        <Style x:Key="RoundedSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#FF6B6B"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="#004040" Offset="0.7"/>
                <GradientStop Color="#057272" Offset="0.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- adaptive rounded background rectangle -->
        <Rectangle
                   Fill="#F6FFFC"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Margin="40"
                   RadiusX="20"
                   RadiusY="20" />

        <Grid Margin="60,60,60,60">
            <Grid.RowDefinitions>
                <RowDefinition Height="17*"/>
                <RowDefinition Height="107*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    CornerRadius="20"
                    Padding="25"
                    BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                    BorderThickness="2" Grid.RowSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="←" 
                        Width="80" Height="36"
                        Background="{DynamicResource ThemeSecondaryBrush}"
                        Foreground="#FFFFFF"
                        BorderBrush="Transparent"
                        FontSize="14"
                        Click="BackButton_Click"
                        Margin="0,0,20,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="MonthText" 
                                       Text="MARCH" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource ThemeSecondaryBrush}"/>
                            <TextBlock x:Name="YearText" 
                                       Text="2025" 
                                       FontSize="16" 
                                        Foreground="{DynamicResource ThemeSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button x:Name="PrevMonthBtn" 
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource ThemeSecondaryBrush}"
                        FontSize="20"
                        FontWeight="Bold"
                        Width="40" Height="40"
                        Click="PrevMonthBtn_Click"
                        Padding="0"
                        Cursor="Hand">
                            <Button.Content>
                                ◄
                            </Button.Content>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="TodayBtn" 
                        Content="TODAY" 
                        Width="120" Height="40"
                        Background="{DynamicResource ThemeSecondaryBrush}"
                        Foreground="#FFFFFF"
                        BorderBrush="Transparent"
                        FontSize="14"
                        FontWeight="Bold"
                        Margin="10,0,10,0"
                         Click="TodayBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="NextMonthBtn" 
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource ThemeSecondaryBrush}"
                        FontSize="20"
                        FontWeight="Bold"
                        Width="40" Height="40"
                        Click="NextMonthBtn_Click"
                        Padding="0"
                        Cursor="Hand">
                            <Button.Content>
                                ►
                            </Button.Content>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid x:Name="DaysOfWeekGrid" Grid.Row="0" Rows="1" Columns="7" Margin="0,0,0,10">
                            <TextBlock x:Name="DaySunText" Text="Sun" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#0B4539"/>
                            <TextBlock x:Name="DayMonText" Text="Mon" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#0B4539"/>
                            <TextBlock x:Name="DayTueText" Text="Tue" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#0B4539"/>
                            <TextBlock x:Name="DayWedText" Text="Wed" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#0B4539"/>
                            <TextBlock x:Name="DayThuText" Text="Thu" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#0B4539"/>
                            <TextBlock x:Name="DayFriText" Text="Fri" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#0B4539"/>
                            <TextBlock x:Name="DaySatText" Text="Sat" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#0B4539"/>
                        </UniformGrid>

                        <UniformGrid x:Name="CalendarGrid" 
                                     Grid.Row="1" 
                                     Rows="6" 
                                     Columns="7"
                                     Margin="0">
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT SIDE -->
            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    CornerRadius="20"
                    Padding="25"
                    Margin="20,0,0,0"
                    BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                    BorderThickness="2" Grid.RowSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock x:Name="TasksHeader"
                                   Text="TODAY'S TASKS"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeSecondaryBrush}"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="AddTaskBtn" 
                        Content="+"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="{DynamicResource ThemeSecondaryBrush}"
                        FontSize="24"
                        FontWeight="Bold"
                        Width="40" Height="40"
                        Click="AddTaskBtn_Click"
                        Margin="10,0,0,0"
                        Padding="0"
                        Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                    Background="Transparent"
                                    CornerRadius="20">      
                                        <ContentPresenter HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F6FFFC"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#E0F8F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="TasksPanel">
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock x:Name="ShowFilterLabel" Text="Show:" 
                       Foreground="{DynamicResource ThemeSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                        <Border CornerRadius="8" 
                           Background="{DynamicResource ThemeBackgroundBrush}" 
                           BorderBrush="{DynamicResource ThemeBorderLightBrush}"
            BorderThickness="1" 
            Padding="4" 
            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FilterAllBtn" 
                                Content="All" 
                                Width="80" Height="30"
                                Background="{DynamicResource ThemeSecondaryBrush}"
                                Foreground="#FFFFFF"
                                BorderBrush="Transparent"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="2"
                                Click="FilterButton_Click"
                                Tag="All">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="FilterActiveBtn" 
                                Content="Active" 
                                Width="59" Height="30"
                                Background="{DynamicResource ThemeBackgroundBrush}"
                                Foreground="{DynamicResource ThemeSecondaryBrush}"
                                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                BorderThickness="1"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="2"
                                Click="FilterButton_Click"
                                Tag="Active">       
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#E0F7F0"/>
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="#D0F0E0"/>
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="FilterCompletedBtn" 
                                Content="Completed" 
                                Width="90" Height="30"
                                Background="{DynamicResource ThemeBackgroundBrush}"
                                Foreground="{DynamicResource ThemeSecondaryBrush}"
                                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                BorderThickness="1"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="2"
                                Click="FilterButton_Click"
                                Tag="Completed">    
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeBorderLightBrush}"/>
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeBorderLightBrush}"/>
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="FilterUpcomingBtn" 
                                Content="Upcoming" 
                                Width="91" Height="30"
                                Background="{DynamicResource ThemeBackgroundBrush}"
                                Foreground="{DynamicResource ThemeSecondaryBrush}"
                                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                BorderThickness="1"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Margin="2"
                                Click="FilterButton_Click"
                                Tag="Upcoming"> 
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">   
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeBorderLightBrush}"/>
                                                                <Setter Property="Opacity" Value="0.9"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeBorderLightBrush}"/>
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ADD TASK PANEL -->
        <Border x:Name="AddTaskPanel"
                Width="450"
                Height="600"
                Background="#FFFFFF"
                CornerRadius="20"
                BorderBrush="{DynamicResource ThemeSecondaryBrush}"
                BorderThickness="2"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Panel.ZIndex="1000">

            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="AddTaskPanelTitle" Text="NEW TASK" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource ThemeSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button x:Name="CloseAddPanelBtn"
                            Grid.Column="1"
                            Content="×"
                            Width="32" 
                            Height="32"
                            Background="Transparent"
                            Foreground="{DynamicResource ThemeSecondaryBrush}"
                            BorderBrush="Transparent"
                            FontSize="24"
                            FontWeight="Bold"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CloseAddPanelBtn_Click"
                            Style="{StaticResource RoundedButtonStyle}"/>
                </Grid>

                <Label x:Name="AddTaskNameLabel" Grid.Row="1" 
                       Content="Task name:" 
                       Foreground="{DynamicResource ThemeSecondaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"/>

                <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource ThemeBackgroundBrush}" Padding="0" Margin="0,5,0,15" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1">
                    <TextBox x:Name="AddTaskTitle" Height="45" Background="Transparent" Foreground="{DynamicResource ThemeSecondaryBrush}" BorderThickness="0" FontSize="14" Padding="12,0,12,0" VerticalContentAlignment="Center"/>
                </Border>

                <Label x:Name="AddTaskDescLabel" Grid.Row="3" 
                       Content="Description (optional):" 
                       Foreground="#0B4539" 
                       FontSize="14"
                       FontWeight="SemiBold"/>

                <Border Grid.Row="4" CornerRadius="8" Background="{DynamicResource ThemeBackgroundBrush}" Padding="0" Margin="0,5,0,15" BorderBrush="{DynamicResource ThemeBorderLightBrush}" BorderThickness="1">
                    <TextBox x:Name="AddTaskDescription" Height="80" Background="Transparent" Foreground="{DynamicResource ThemeSecondaryBrush}" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Hidden" FontSize="13" Padding="12" VerticalContentAlignment="Top"/>
                </Border>

                <Label x:Name="AddTaskTimeLabel" Grid.Row="5"
                       Content="Time (optional):"
                       Foreground="{DynamicResource ThemeSecondaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,5,0,15" VerticalAlignment="Center">
                    <CheckBox x:Name="AddTaskHasTime" 
                              Content="Set time" 
                              VerticalAlignment="Center" 
                              IsChecked="False" 
                              Checked="AddTaskHasTime_Checked" 
                              Unchecked="AddTaskHasTime_Unchecked" 
                              Margin="0,0,12,0"/>
                    <Border x:Name="AddTaskTimeBorder" 
                            CornerRadius="8" 
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                            BorderThickness="1" 
                            Padding="10,6" 
                            VerticalAlignment="Center" 
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="AddTaskTime" 
                                     Width="80" 
                                     Height="30" 
                                     Background="Transparent" 
                                     Foreground="{DynamicResource ThemeSecondaryBrush}"
                                     BorderThickness="0" 
                                     FontSize="14" 
                                     Padding="6" 
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Center"
                                     MaxLength="5"
                                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                                     PreviewKeyDown="TimeTextBox_PreviewKeyDown"
                                     Text="09:00"
                                     ToolTip="Enter time in 24-hour format (00:00 - 23:59)"/>
                            <TextBlock x:Name="AddTaskTimeFormatHint" Text="" 
                                       Foreground="{DynamicResource ThemeSecondaryBrush}"
                                       VerticalAlignment="Center" 
                                       Margin="6,0,0,0"
                                       FontSize="12"
                                       Opacity="0.7">
                                <Run Text="(24h format)"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Label x:Name="AddTaskCategoryLabel" Grid.Row="7" 
                       Content="Category (color):" 
                       Foreground="{DynamicResource ThemeSecondaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"/>

                <ScrollViewer x:Name="CategoryScrollViewer" Grid.Row="8" 
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,5,0,10"
                              Height="160"
                              PanningMode="HorizontalOnly"
                              CanContentScroll="False">
                    <WrapPanel Orientation="Horizontal">
                        <Border Margin="5" 
                                Padding="12" 
                                Background="{DynamicResource ThemeBackgroundBrush}"
                                CornerRadius="10"
                                Width="190">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="ColorRed" 
                                                GroupName="TaskColors"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource ColorRadioButtonStyle}">
                                        <RadioButton.Content>
                                            <Border Width="28" 
                                                    Height="28" 
                                                    CornerRadius="14"
                                                    Background="#FF6B6B"
                                                    BorderThickness="2"
                                                    BorderBrush="Transparent">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryBrush}"/>
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </RadioButton.Content>
                                    </RadioButton>
                                    <StackPanel>
                                        <TextBlock x:Name="CategoryImportantText" Text="Important" 
                                                   Foreground="{DynamicResource ThemeSecondaryBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CategoryImportantDescText" Text="Priority tasks" 
                                                   Foreground="{DynamicResource ThemeSecondaryBrush}"
                                                   FontSize="11"
                                                   Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="5" 
                                Padding="12" 
                                Background="{DynamicResource ThemeBackgroundBrush}"
                                CornerRadius="10"
                                Width="190">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="ColorBlue" 
                                                GroupName="TaskColors"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                IsChecked="True"
                                                Style="{StaticResource ColorRadioButtonStyle}">
                                        <RadioButton.Content>
                                            <Border Width="28" 
                                                    Height="28" 
                                                    CornerRadius="14"
                                                    Background="#4A6CF7"
                                                    BorderThickness="2"
                                                    BorderBrush="Transparent">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryBrush}"/>
                                                                <Setter Property="BorderThickness" Value="3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </RadioButton.Content>
                                    </RadioButton>
                                    <StackPanel>
                                        <TextBlock x:Name="CategoryWorkText" Text="Work" 
                                                   Foreground="{DynamicResource ThemeSecondaryBrush}"
                                                   FontSize="14"
