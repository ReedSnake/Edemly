<Page x:Class="uchat.Page_login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:uchat"
      xmlns:lang="clr-namespace:uchat.Lang"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Page_login">

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#021A1A" Offset="0.0"/>
                <GradientStop Color="#052A2A" Offset="0.5"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Image Grid.Column="0" Grid.ColumnSpan="2"
               HorizontalAlignment="Left"
               Source="/Assets/7.png" 
               Stretch="UniformToFill"
               RenderTransformOrigin="0.5,0.5" Margin="80,0,0,0"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="300,0,100,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,30">
                <Image Source="/Assets/logo.png" 
                       Width="64" 
                       Height="53" 
                       VerticalAlignment="Center"/>
                <TextBlock Text="Edemly" 
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontSize="36" 
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           FontFamily="./fonts/#Comfortaa"/>
            </StackPanel>

            <TextBlock HorizontalAlignment="Left" 
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontSize="36" 
                       FontFamily="./fonts/#Comfortaa" 
                       Margin="0,0,0,30"
                       Text="{x:Static lang:DefaultLanguage.WelcomeTitle}"/>
						
            <Viewbox Stretch="Uniform" MaxWidth="400" HorizontalAlignment="Left">
                <StackPanel Width="300" Margin="0,0,0,20">

                    <TextBlock Text="{x:Static lang:DefaultLanguage.EmailLabel}" 
                               HorizontalAlignment="Left" 
                               Foreground="#888888" 
                               FontSize="16" 
                               FontFamily="Century Gothic"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="EmailTextBox" 
                             Height="45" 
                             FontSize="16" 
                             FontFamily="Century Gothic" 
                             Background="Transparent" 
                             Foreground="#888888" 
                             BorderBrush="#888888" 
                             BorderThickness="1" 
                             Padding="15,0,0,0"
                             Margin="0,0,0,20"
                             KeyDown="EmailTextBox_KeyDown" >
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="10">
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <CheckBox x:Name="RememberMeCheckBox"
                               VerticalAlignment="Top"
                               Margin="0,0,8,0"
                               IsChecked="True">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Border x:Name="border"
                                                     Background="Transparent"
                                                     BorderBrush="{DynamicResource ThemeSecondaryBrush}"

                                                     BorderThickness="2"
                                                     CornerRadius="3"
                                                     Width="16"
                                                     Height="16">
                                                    <TextBlock x:Name="checkMark"
                                                        Text="✓"
                                                        Foreground="Transparent"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
                                                        <Setter TargetName="checkMark" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <TextBlock Text="{x:Static lang:DefaultLanguage.RememberMe}" 
                                VerticalAlignment="Center"
                                Foreground="#888888" 
                                FontSize="12" 
                                FontFamily="Century Gothic"/>
                    </StackPanel>

                    <Button x:Name="LoginButton" 
                            Content="{x:Static lang:DefaultLanguage.LoginButton}" 
                            Height="45" 
                            Background="{DynamicResource ThemeSecondaryBrush}"

                            Foreground="White" 
                            FontSize="16" 
                            FontFamily="Century Gothic" 
                            BorderThickness="0" 
                            Click="LoginButton_Click"
                            Margin="0,0,0,15">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock x:Name="SignUpText" 
                               HorizontalAlignment="Center" 
                               Foreground="Black" 
                               FontSize="14" 
                               FontFamily="Century Gothic" 
                               MouseLeftButtonDown="SignUpText_MouseLeftButtonDown">
                        <Run Text="{x:Static lang:DefaultLanguage.NoAccount}"/>
                        <Run Text="{x:Static lang:DefaultLanguage.SignUp}" Foreground="{DynamicResource ThemeSecondaryBrush}" FontWeight="Bold" Cursor="Hand"/>
                    </TextBlock>
                </StackPanel>
            </Viewbox>
        </StackPanel>
    </Grid>
</Page>