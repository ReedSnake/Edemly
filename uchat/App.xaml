<Application x:Class="uchat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:uchat">
    <Application.Resources>
        <!-- Embedded app font resource (change in one place to update everywhere) -->
        <!-- The URI points to the TTF placed in Assets and included as Resource by the project file -->
        <FontFamily x:Key="AppFont">pack://application:,,,/Assets/segoe-ui-emoji_0.ttf#segoe-ui-emoji_0</FontFamily>

        <!-- Background image resource (may be set at runtime). Provide default keys so XAML DynamicResource lookups succeed. -->
        <x:Null x:Key="BackgroundImage" />
        <ImageBrush x:Key="BackgroundImageBrush" ImageSource="{DynamicResource BackgroundImage}" Stretch="UniformToFill" />

        <!-- Theme resources - these will be updated dynamically by ThemeService -->
        <SolidColorBrush x:Key="ThemePrimaryBrush">#057272</SolidColorBrush>
        <SolidColorBrush x:Key="ThemePrimaryLightBrush">#00B8B8</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeSecondaryBrush">#0B4539</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeBackgroundBrush">#F6FFFC</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeBackgroundDarkBrush">#004040</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush">#031C1C</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush">#666666</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeBorderBrush">#E0E0E0</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeBorderLightBrush">#C3F0E1</SolidColorBrush>

        <LinearGradientBrush x:Key="ThemeGradientBrush" StartPoint="1,1" EndPoint="0,0">
            <GradientStop Color="#004040" Offset="0.7"/>
            <GradientStop Color="#057272" Offset="0.0"/>
        </LinearGradientBrush>

        <!-- Ensure text elements and controls inherit the AppFont -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <Style TargetType="TextElement">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <!-- Base control style: most controls inherit FontFamily from Control -->
        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <!-- Explicit common controls to be safe -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="ListView" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type Control}}" />
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>
        <Style TargetType="Menu">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <!-- Default font for Window and Page -->
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <Style TargetType="Page">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <!-- Existing resources (animations etc.) -->
        <Storyboard x:Key="PageSlideInFromRight">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="PageSlideOutToLeft">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-100">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="PageSlideInFromLeft">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="PageSlideOutToRight">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="100">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Application.Resources>
</Application>