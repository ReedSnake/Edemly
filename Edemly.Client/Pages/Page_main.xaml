<Page x:Class="Edemly.Client.Page_main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:Edemly.Client.Helpers"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Edemly.Client"
      mc:Ignorable="d" 
      Title="Page_main"
      d:DesignHeight="720" d:DesignWidth="1280"
      PreviewMouseWheel="Page_PreviewMouseWheel">
    <Grid x:Name="MainGrid" ClipToBounds="True" VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="300" MinWidth="250" MaxWidth="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.Background>
            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="#004040" Offset="0.7"/>
                <GradientStop Color="#057272" Offset="0.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Grid.Column="0" Background="Transparent" Padding="0" Panel.ZIndex="1">
            <Grid x:Name="LeftGrid" Margin="20,30,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MenuButton" Grid.Column="0" Content="☰" Width="60" Height="60" 
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            FontSize="22" Background="{DynamicResource ThemeSecondaryBrush}" Foreground="White" BorderThickness="0" Click="MenuButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBox x:Name="SearchTextBox" Grid.Column="1"
                             HorizontalAlignment="Left"
                             Margin="12,0,0,0"
                             Width="208" MinWidth="120" MaxWidth="260"
                             Height="60"
                             VerticalAlignment="Center"
                             Background="{DynamicResource ThemeBackgroundBrush}"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                             CaretBrush="{DynamicResource ThemeTextPrimaryBrush}"
                             TextAlignment="Left"
                             VerticalContentAlignment="Center"
                             BorderThickness="2"
                             BorderBrush="{DynamicResource ThemePrimaryLightBrush}"
                             FontSize="14"
                             Padding="10,0,10,0"
                             TextWrapping="NoWrap">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <Button x:Name="MyPlannerButton" Grid.Row="1" Height="58" Margin="3,20,0,0" VerticalAlignment="Top" Width="277"
                        Click="MyPlannerButton_Click"
                        Background="{DynamicResource ThemeBackgroundBrush}"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                        BorderBrush="{DynamicResource ThemeSecondaryBrush}"
                        BorderThickness="1" HorizontalAlignment="Left">
                    <TextBlock x:Name="MyPlannerButtonText" Text="My planer" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="237"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="0" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
                                                <Setter TargetName="border" Property="CornerRadius" Value="14"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-3" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="4" BlurRadius="10" Opacity="0.15"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border Grid.Row="2" HorizontalAlignment="Left" Margin="3,20,0,20" VerticalAlignment="Stretch" Width="277"
                        Background="{DynamicResource ThemeBackgroundBrush}" CornerRadius="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,15,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ChatsHeaderText" Grid.Column="0" Text="Chats" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>

                            <Button x:Name="CreateGroupButton" Grid.Column="1" Content="+" 
                            Width="30" Height="30"
                            Background="{DynamicResource ThemeSecondaryBrush}" Foreground="White" 
                            BorderThickness="0"
                            FontSize="20" FontWeight="Bold"
                            Click="CreateGroupButton_Click"
                            Margin="0,0,10,0"
                            ToolTip="Create Group">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="15">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="0" 
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ChatsPanel" Orientation="Vertical" 
                                        MaxWidth="257" 
                                        HorizontalAlignment="Stretch"
                                        Margin="10,0,10,10">
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
        Background="{DynamicResource ThemeBackgroundBrush}"
        CornerRadius="40"
        Margin="20"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Panel.ZIndex="0">
            

            <Grid x:Name="RightGrid" >
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="123*"/>
                    <RowDefinition Height="331*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border CornerRadius="20"
        Grid.Row="0"
        Grid.RowSpan="4"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Panel.ZIndex="1"
        IsHitTestVisible="False">

                    <Border.Background>
                        <ImageBrush ImageSource="{DynamicResource BackgroundImage}"
                    Stretch="UniformToFill"/>
                    </Border.Background>

                </Border>

                <Border x:Name="ChatHeaderContainer" Grid.Row="0" Height="81" Margin="20,20,20,0" 
                Background="{DynamicResource ThemePrimaryLightBrush}" VerticalAlignment="Top"
                CornerRadius="25" Panel.ZIndex="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Border x:Name="ChatHeaderAvatarBorder"
                                    Width="53"
                                    Height="53"
                                    CornerRadius="26.5"
                                    BorderBrush="{DynamicResource ThemeSecondaryBrush}"
                                    BorderThickness="2"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <ImageBrush x:Name="ChatHeaderAvatarBackground"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="ChatHeaderText"
                                           Text=""
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel x:Name="OnlineStatusPanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,4,0,0"
                                            Visibility="Collapsed">
                                    <Ellipse x:Name="OnlineIndicator"
                                             Width="10"
                                             Height="10"
                                             Fill="Gray"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusText"
                                               Text="Offline"
                                               FontSize="12"
                                               Foreground="Gray"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="CallButton" Content="📞" Width="40" Height="40" 
                                        Background="Transparent" Foreground="#000000" BorderThickness="0" FontSize="16" Click="CallButton_Click"
                                        ToolTip="Start call" Margin="0,0,6,0"/>

                                <Button x:Name="ContactMenuButton" Content="⋯"
                                        Width="40"
                                        Height="40"
                                        Background="Transparent"
                                        Foreground="#000000"
                                        BorderThickness="0"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Click="ContactMenuButton_Click"
                                        Visibility="Visible"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="90.635"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Button.RenderTransform>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="20">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Margin="20,68,20,91" Grid.RowSpan="3" Grid.Row="1" Panel.ZIndex="2">
                    <ScrollViewer x:Name="MessagesScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="0"
                                  PanningMode="VerticalFirst"
                                  PreviewMouseWheel="MessagesScrollViewer_PreviewMouseWheel">
                        <StackPanel x:Name="MessagesPanel" Orientation="Vertical">
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3" 
                        VerticalAlignment="Top"
                        CornerRadius="0,0,40,40" 
                        Margin="20,24,20,0" 
                        Padding="10" 
                        Background="Transparent"
                        Panel.ZIndex="2" Height="91">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AttachFileButton"
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Background="white"
                            Foreground="{DynamicResource ThemePrimaryLightBrush}"
                            Click="AttachFileButton_Click"
                            ToolTip="Attach file"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            Padding="0"
                            BorderBrush="{DynamicResource ThemePrimaryLightBrush}"
                            BorderThickness="2">
                            <Button.Content>
                                <Viewbox Width="24" Height="24">
                                    <Path Fill="{DynamicResource ThemePrimaryLightBrush}"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M17.1459084,11.1469857 C17.3408728,10.9514263 17.6574549,10.9509439 17.8530143,11.1459084 C18.0485737,11.3408728 18.0490561,11.6574549 17.8540916,11.8530143 L11.9096172,17.8156301 C10.3312795,19.3987845 7.7683837,19.4026893 6.1849596,17.8240826 C4.60179277,16.2409218 4.60179277,13.6807396 6.18134874,12.1011843 L12.4395893,5.8770467 C13.6049179,4.71807195 15.4883496,4.72064626 16.6505056,5.88280226 C17.8123042,7.04460086 17.8125519,8.92817214 16.651059,10.0902763 L10.2949559,16.4497244 C9.54331608,17.2017597 8.32434648,17.2020804 7.57226458,16.4503941 C6.81988433,15.6980139 6.81780588,14.4793123 7.56730486,13.7246829 L12.1291989,9.13156162 C12.3237939,8.93563459 12.6403745,8.93455475 12.8363015,9.12914974 C13.0322286,9.32374472 13.0333084,9.64032537 12.8387134,9.83625241 L8.27681941,14.4293736 C7.91557205,14.7930938 7.91657383,15.3804899 8.27901321,15.7429292 C8.64064021,16.1043661 9.22644486,16.104212 9.58766315,15.7428036 L15.9437662,9.38335557 C16.7149102,8.61180574 16.7147457,7.36125599 15.9433988,6.58990904 C15.1710124,5.81752267 13.9192554,5.81581175 13.1447605,6.58608381 L6.89434715,12.8024168 C5.69942385,13.9973221 5.69942385,15.9243393 6.88770251,17.1126181 C8.0832935,18.3045772 10.013025,18.3016371 11.2014339,17.1096014 L17.1459084,11.1469857 Z">
                                    </Path>
                                </Viewbox>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Grid.Column="1"
                                Margin="12,0"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource ThemePrimaryLightBrush}"
                                CornerRadius="14"
                                Background="white"
                                VerticalAlignment="Center">
                            <TextBox x:Name="MessageTextBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="16"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     TextAlignment="Left"
                                     Padding="12,0,12,0"
                                     TextWrapping="Wrap"
                                     MinHeight="50"
                                     MaxHeight="100"
                                     Text="Message..."
                                     Foreground="{DynamicResource ThemePrimaryLightBrush}"
                                     FontStyle="Italic"
                                     AcceptsReturn="True"
                                     PreviewKeyDown="MessageTextBox_PreviewKeyDown"
                                     TextChanged="MessageTextBox_TextChanged"
                                     VerticalScrollBarVisibility="Hidden"
                                     HorizontalScrollBarVisibility="Disabled"/>
                        </Border>
                        <Button x:Name="StickerButton"
                            Grid.Column="3"
                            Width="48"
                            Height="48"
                            Background="white"
                            Foreground="{DynamicResource ThemePrimaryLightBrush}"
                            FontSize="20"
                            Click="StickerButton_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource ThemePrimaryLightBrush}"
                            BorderThickness="2">
                            <Button.Content>
                                <Viewbox Width="24" Height="24">
                                    <Path Fill="{DynamicResource ThemePrimaryLightBrush}" 
              Data="M20,11.5 L20,7.5 C20,5.56700338 18.4329966,4 16.5,4 L7.5,4 C5.56700338,4 4,5.56700338 4,7.5 L4,16.5 C4,18.4329966 5.56700338,20 7.5,20 L12.5,20 C13.3284271,20 14,19.3284271 14,18.5 L14,16.5 C14,14.5670034 15.5670034,13 17.5,13 L18.5,13 C19.3284271,13 20,12.3284271 20,11.5 Z M19.9266247,13.5532532 C19.522053,13.8348821 19.0303092,14 18.5,14 L17.5,14 C16.1192881,14 15,15.1192881 15,16.5 L15,18.5 C15,18.9222858 14.8952995,19.3201175 14.7104416,19.668952 C17.4490113,18.8255402 19.5186665,16.4560464 19.9266247,13.5532532 L19.9266247,13.5532532 Z M7.5,3 L16.5,3 C18.9852814,3 21,5.01471863 21,7.5 L21,12.5 C21,17.1944204 17.1944204,21 12.5,21 L7.5,21 C5.01471863,21 3,18.9852814 3,16.5 L3,7.5 C3,5.01471863 5.01471863,3 7.5,3 Z" />
                                </Viewbox>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="SendButton"
                                Grid.Column="2"
                                Width="48"
                                Height="48"
                                Background="white"
                                Foreground="{DynamicResource ThemePrimaryLightBrush}"
                                FontSize="20"
                                Click="SendButton_Click"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,10,10,10"
                                BorderBrush="{DynamicResource ThemePrimaryLightBrush}"
                                BorderThickness="2">
                            <Button.Content>
                                <Viewbox Width="24" Height="24">
                                    <Path Fill="{DynamicResource ThemePrimaryLightBrush}"
                                        Data="M11.5003 12H5.41872M5.24634 12.7972L4.24158 15.7986C3.69128 17.4424 3.41613 18.2643 3.61359 18.7704C3.78506 19.21 4.15335 19.5432 4.6078 19.6701C5.13111 19.8161 5.92151 19.4604 7.50231 18.7491L17.6367 14.1886C19.1797 13.4942 19.9512 13.1471 20.1896 12.6648C20.3968 12.2458 20.3968 11.7541 20.1896 11.3351C19.9512 10.8529 19.1797 10.5057 17.6367 9.81135L7.48483 5.24303C5.90879 4.53382 5.12078 4.17921 4.59799 4.32468C4.14397 4.45101 3.77572 4.78336 3.60365 5.22209C3.40551 5.72728 3.67772 6.54741 4.22215 8.18767L5.24829 11.2793C5.34179 11.561 5.38855 11.7019 5.407 11.8459C5.42338 11.9738 5.42321 12.1032 5.40651 12.231C5.38768 12.375 5.34057 12.5157 5.24634 12.7972Z"/>
                                </Viewbox>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Rectangle x:Name="Overlay" Grid.ColumnSpan="2"
           Fill="#80000000" 
           Visibility="Collapsed" 
           MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
           Panel.ZIndex="900"/>

        <Border x:Name="SideMenu" Grid.Column="0"
        Width="293" 
        Height="500" 
        Background="{DynamicResource ThemeBackgroundBrush}"
        CornerRadius="0,0,40,40"
        HorizontalAlignment="Left" 
        VerticalAlignment="Top"
        Margin="15,0,0,0"
        Padding="0,0,0,0"
        RenderTransformOrigin="0.5,0.5"
        Panel.ZIndex="1000" Grid.ColumnSpan="2">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SideMenuTransform" X="-350"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="10" BlurRadius="20" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel Margin="20,0,20,0" HorizontalAlignment="Stretch">
                <TextBlock x:Name="MenuTitleText" Text="Menu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="15,40,0,20" HorizontalAlignment="Left"/>

                <Button x:Name="SettingsButton" Content="⚙️ Settings" 
                Height="50" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderThickness="0" FontSize="16"
                HorizontalContentAlignment="Left" Padding="15,0,0,0"
                Click="SettingsButton_Click"
                HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                      VerticalAlignment="Center" 
                                                      Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="PremiumButton" Content="👑 Premium" 
                Height="50" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimaryBrush}" 
                BorderThickness="0" FontSize="16"
                HorizontalContentAlignment="Left" Padding="15,0,0,0"
                Click="PremiumButton_Click" HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                      VerticalAlignment="Center" 
                                      Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="HelpButton" Content="❓ About the app" 
                Height="50" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderThickness="0" FontSize="16"
                HorizontalContentAlignment="Left" Padding="15,0,0,0"
