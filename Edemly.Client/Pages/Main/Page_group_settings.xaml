<common:ThemedPage x:Class="Edemly.Client.Pages.Main.Page_group_settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:lang="clr-namespace:Edemly.Client.Application.Localization"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1280">

    <common:ThemedPage.Resources>
        <Style x:Key="GroupSettingsSectionStyle"
               TargetType="Border"
               BasedOn="{StaticResource SettingsSectionStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="30" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="GroupSettingsHeaderSaveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HeaderSaveButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>

        <Style x:Key="GroupSettingsChangeIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ChangeIconButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style x:Key="GroupSettingsBottomSaveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BottomSaveButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="GroupIconBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource SettingsCardBorderStyle}">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="120" />
            <Setter Property="CornerRadius" Value="60" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="GroupMembersContainerStyle"
               TargetType="Border"
               BasedOn="{StaticResource SettingsCardBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MaxHeight" Value="300" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </common:ThemedPage.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Border Height="80"
                Panel.ZIndex="1000"
                Margin="70,48,70,592">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Style="{StaticResource BackButtonStyle}"
                        Content="←"
                        Margin="0,14,0,0"
                        Panel.ZIndex="1000"
                        Click="BackButton_Click" />

                <Button x:Name="HeaderSaveButton"
                        Grid.Column="2"
                        Style="{StaticResource GroupSettingsHeaderSaveButtonStyle}"
                        Click="SaveButton_Click">
                    <TextBlock Text="{x:Static lang:DefaultLanguage.SaveChanges}" />
                </Button>
            </Grid>
        </Border>

        <Border Background="{DynamicResource ThemeSurfaceBrush}"
                CornerRadius="40"
                Margin="50,29,50,47"
                Padding="40">
            <ScrollViewer HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel Width="600"
                            HorizontalAlignment="Center">

                    <Border Style="{StaticResource GroupSettingsSectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                       Text="{x:Static lang:DefaultLanguage.GroupIcon}"
                                       Margin="0,0,0,20" />

                            <Border Style="{StaticResource GroupIconBorderStyle}">
                                <Border.Background>
                                    <ImageBrush x:Name="GroupIconImage"
                                                Stretch="UniformToFill"
                                                ImageSource="pack://application:,,,/Assets/Avatars/default-avatar.png" />
                                </Border.Background>
                            </Border>

                            <Button x:Name="ChangeIconButton"
                                    Style="{StaticResource GroupSettingsChangeIconButtonStyle}"
                                    Click="ChangeIconButton_Click">
                                <TextBlock Text="{x:Static lang:DefaultLanguage.ChangeIcon}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupSettingsSectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                       Text="{x:Static lang:DefaultLanguage.GroupName}" />

                            <TextBox x:Name="GroupNameTextBox"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     MaxLength="50" />

                            <TextBlock Style="{StaticResource SettingsHintTextStyle}"
                                       Text="{x:Static lang:DefaultLanguage.Characters1To50}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupSettingsSectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                       Text="{x:Static lang:DefaultLanguage.GroupDescription}" />

                            <TextBox x:Name="GroupDescriptionTextBox"
                                     Style="{StaticResource MultilineTextBoxStyle}"
                                     MaxLength="200"
                                     Height="100"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" />

                            <TextBlock Style="{StaticResource SettingsHintTextStyle}"
                                       Text="{x:Static lang:DefaultLanguage.Characters0To200}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupSettingsSectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSectionTitleStyle}"
                                       Text="{x:Static lang:DefaultLanguage.GroupMembers}" />

                            <Border Style="{StaticResource GroupMembersContainerStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                    <StackPanel x:Name="GroupMembersPanel"
                                                Orientation="Vertical">
                                        <TextBlock Text="{x:Static lang:DefaultLanguage.LoadingMembers}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="10" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource ThemePrimaryBrush}"
                            CornerRadius="10"
                            Cursor="Hand"
                            Margin="0,20,0,0">
                        <Button x:Name="SaveButton"
                                Style="{StaticResource GroupSettingsBottomSaveButtonStyle}"
                                Click="SaveButton_Click">
                            <TextBlock Text="{x:Static lang:DefaultLanguage.SaveChangesButton}" />
                        </Button>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</common:ThemedPage>
