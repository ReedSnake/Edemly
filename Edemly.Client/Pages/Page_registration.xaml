<Page x:Class="Edemly.Client.Page_registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Edemly.Client"
      xmlns:lang="clr-namespace:Edemly.Client.Lang"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Page_registration">

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#021A1A" Offset="0.0"/>
                <GradientStop Color="#052A2A" Offset="0.5"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Image Grid.Column="0" Grid.ColumnSpan="2"
               HorizontalAlignment="Left"
               Source="/Assets/7.png" 
               Stretch="UniformToFill"
               RenderTransformOrigin="0.5,0.5" Margin="80,0,0,0"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="300,0,100,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                <Image Source="/Assets/logo.png" 
                       Width="64" 
                       Height="53" 
                       VerticalAlignment="Center"/>
                <TextBlock Text="Edemly" 
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontSize="36" 
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           FontFamily="./fonts/#Comfortaa"/>
            </StackPanel>

            <TextBlock HorizontalAlignment="Left" 
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontSize="36" 
                       FontFamily="./fonts/#Comfortaa" 
                       Margin="0,0,0,20">
                <Run Text="{x:Static lang:DefaultLanguage.RegistrationTitleLine1}"/>
                <LineBreak/>
                <Run Text="{x:Static lang:DefaultLanguage.RegistrationTitleLine2}"/>
            </TextBlock>

            <Viewbox Stretch="Uniform" MaxWidth="400" HorizontalAlignment="Left">
                <StackPanel Width="300" Margin="0,0,0,20">

                    <TextBlock Text="{x:Static lang:DefaultLanguage.UserNameLabel}" 
                               HorizontalAlignment="Left" 
                               Foreground="#888888" 
                               FontSize="16" 
                               FontFamily="Century Gothic"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="FullNameTextBox" 
                             Height="45" 
                             FontSize="16" 
                             FontFamily="Century Gothic" 
                             Background="Transparent" 
                             Foreground="#888888" 
                             BorderBrush="#888888" 
                             BorderThickness="1" 
                             Padding="15,0,0,0"
                             Margin="0,0,0,15"
                             TextChanged="FullNameTextBox_TextChanged"
                             KeyDown="TextBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="10">
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Text="{x:Static lang:DefaultLanguage.RegistrationEmailLabel}" 
                               HorizontalAlignment="Left" 
                               Foreground="#888888" 
                               FontSize="16" 
                               FontFamily="Century Gothic"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="EmailTextBox" 
                             Height="45" 
                             FontSize="16" 
                             FontFamily="Century Gothic" 
                             Background="Transparent" 
                             Foreground="#888888" 
                             BorderBrush="#888888" 
                             BorderThickness="1" 
                             Padding="15,0,0,0"
                             Margin="0,0,0,20"
                             KeyDown="TextBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="10">
                                                <ScrollViewer x:Name="PART_ContentHost" 
                                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox x:Name="TermsCheckBox"
                               VerticalAlignment="Top"
                               Margin="0,0,8,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Border x:Name="border"
                                                     Background="Transparent"
                                                     BorderBrush="{DynamicResource ThemeSecondaryBrush}"
                                                     BorderThickness="2"
                                                     CornerRadius="3"
                                                     Width="16"
                                                     Height="16">
                                                    <TextBlock x:Name="checkMark"
                                                        Text="✓"
                                                        Foreground="Transparent"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="Bold"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
                                                        <Setter TargetName="checkMark" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <TextBlock TextWrapping="Wrap" 
                                VerticalAlignment="Center"
                                Foreground="#888888" 
                                FontSize="12" 
                                FontFamily="Century Gothic">
                            <Run Text="{x:Static lang:DefaultLanguage.TermsLine1}"/>
                            <LineBreak/>
                            <Hyperlink Click="OpenPolicies_Click">
                                <Run Text="{x:Static lang:DefaultLanguage.TermsLine2}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    
<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
    <CheckBox x:Name="RememberMeCheckBox"
           VerticalAlignment="Top"
           Margin="0,0,8,0">
        <CheckBox.Style>
            <Style TargetType="CheckBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="border"
                                 Background="Transparent"
                                 BorderBrush="{DynamicResource ThemeSecondaryBrush}"
                                 BorderThickness="2"
                                 CornerRadius="3"
                                 Width="16"
                                 Height="16">
                                <TextBlock x:Name="checkMark"
                                    Text="✓"
                                    Foreground="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSecondaryBrush}"/>
                                <Setter TargetName="checkMark" Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </CheckBox.Style>
    </CheckBox>
    <TextBlock Text="{x:Static lang:DefaultLanguage.RememberMe}" 
            VerticalAlignment="Center"
            Foreground="#888888" 
            FontSize="12" 
            FontFamily="Century Gothic"/>
</StackPanel>

                    <Button x:Name="SignUpButton" 
                            Content="{x:Static lang:DefaultLanguage.SignUpButton}" 
                            Height="45" 
                            Background="{DynamicResource ThemeSecondaryBrush}"
                            Foreground="White" 
                            FontSize="16" 
                            FontFamily="Century Gothic" 
                            BorderThickness="0" 
                            Click="SignUpButton_Click"
                            Margin="0,0,0,15">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock HorizontalAlignment="Center" 
                               Foreground="Black" 
                               FontSize="14" 
                               FontFamily="Century Gothic" 
                               MouseLeftButtonDown="SignInText_MouseLeftButtonDown">
                        <Run Text="{x:Static lang:DefaultLanguage.AlreadyHaveAccount}"/>
                        <Run Text="{x:Static lang:DefaultLanguage.SignIn}" 
                             Foreground="{DynamicResource ThemeSecondaryBrush}"
                             FontWeight="Bold"
                             Cursor="Hand"/>
                    </TextBlock>
                </StackPanel>
            </Viewbox>
        </StackPanel>

        <Border x:Name="PoliciesPanel" Background="#80000000" Visibility="Collapsed" Grid.ColumnSpan="2">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" Height="600">
                <Border Background="White" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="PoliciesTitleText" Text="{x:Static lang:DefaultLanguage.PoliciesTitle}" FontWeight="Bold" FontSize="18" Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Left"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <TextBlock x:Name="PoliciesContentText" TextWrapping="Wrap" FontSize="13" />
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,8,0,0">
                            <Button x:Name="ClosePoliciesButton" Content="{x:Static lang:DefaultLanguage.PoliciesClose}" Click="ClosePolicies_Click" Margin="0,0,8,0" />
                            <Button x:Name="AcceptPoliciesButton" Content="{x:Static lang:DefaultLanguage.PoliciesAccept}" Click="AcceptPolicies_Click" Background="{DynamicResource ThemeSecondaryBrush}" Foreground="White" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>