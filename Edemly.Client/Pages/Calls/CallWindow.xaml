<Window x:Class="Edemly.Client.Pages.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calls" Height="420" Width="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#EDFFFF">
    <Grid x:Name="RootGrid" Margin="8">
        <Border x:Name="NotificationBorder" Background="#DD333333" CornerRadius="6" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Visibility="Collapsed">
            <TextBlock x:Name="NotificationText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="ListViewGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Active calls" FontSize="16" FontWeight="Bold" Margin="8" Foreground="#FF0B4539"/>

            <ScrollViewer Grid.Row="1" Margin="8" VerticalScrollBarVisibility="Hidden">
                <Border CornerRadius="20" Background="{DynamicResource ThemePrimaryLightBrush}" Height="273">
                    <StackPanel x:Name="CallsListPanel" />
                </Border>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
                <Button x:Name="RefreshListButton" 
        Content="Refresh" 
        Width="147" 
        Margin="4" 
        Click="RefreshListButton_Click" Height="36">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource ThemeSecondaryBrush}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="#FFE4FFFA"/>
                    </Button.Foreground>
                </Button>
                <Button x:Name="CloseButton" 
                Content="Close" 
                Width="119" 
                Margin="4" 
                Click="CloseButton_Click" Height="36">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource ThemeSecondaryBrush}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="#FFE4FFFA"/>
                    </Button.Foreground>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="IncomingPrompt" Background="#CC000000" CornerRadius="8" Padding="10" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8" Visibility="Collapsed" Panel.ZIndex="9000">
            <StackPanel Orientation="Horizontal" Width="420">
                <Border Width="56" Height="56" CornerRadius="28" BorderBrush="#FFFFFF" BorderThickness="2" Margin="0,0,8,0">
                    <Image x:Name="IncomingAvatar" Stretch="UniformToFill" />
                </Border>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Width="280">
                    <TextBlock x:Name="IncomingText" Text="Incoming call" FontSize="14" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                    <TextBlock x:Name="IncomingFromText" Text="From: " Foreground="White" Margin="0,6,0,8" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AcceptIncomingButton" Content="Accept" Width="80" Margin="4" Click="AcceptIncomingButton_Click" />
                        <Button x:Name="RejectIncomingButton" Content="Reject" Width="80" Margin="4" Click="RejectIncomingButton_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="DialingPanel" 
        Background="{DynamicResource ThemeBackgroundDarkBrush}"
        CornerRadius="8" 
        Padding="10" 
        VerticalAlignment="Top" 
        HorizontalAlignment="Center" 
        Margin="8" 
        Visibility="Collapsed" 
        Panel.ZIndex="9000">
            <StackPanel Orientation="Vertical" Width="420">
                <TextBlock x:Name="DialingText" Text="Calling..." FontSize="14" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                <TextBlock x:Name="DialingCountdown" Text="30s" Foreground="White" Margin="0,8,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelCallButton" 
                Content="Cancel" 
                Width="80" 
                Margin="4" 
                Click="CancelCallButton_Click"> 
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFE4FFFA" CornerRadius="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Foreground>
                            <SolidColorBrush Color="#FF0B4539"/>
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="CallViewGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="CallTitle" Text="Call" FontSize="16" FontWeight="Bold" Margin="8" />

            <StackPanel Grid.Row="1" Margin="8">
                <TextBlock x:Name="CallInfoText" TextWrapping="Wrap" />
                <Grid x:Name="WebViewHost" Height="240" Margin="0,8,0,0" Background="#111" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="8">
                <Button x:Name="MuteButton" 
                Content="Mute" 
                Width="80" 
                Margin="6" 
                Click="MuteButton_Click">   
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource ThemeSecondaryBrush}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="#FFE4FFFA"/>
                    </Button.Foreground>
                </Button>
                <Button x:Name="EndCallButton" 
                Content="End" 
                Width="80" 
                Margin="6" 
                Click="EndCallButton_Click">    
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource ThemeSecondaryBrush}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="#FFE4FFFA"/>
                    </Button.Foreground>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>