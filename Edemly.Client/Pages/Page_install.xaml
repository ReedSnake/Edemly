<Page x:Class="Edemly.Client.Pages.Page_install"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Edemly.Client.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Install"
      FontFamily="./fonts/#Comfortaa">

    <Page.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0B4539"/>
            <Setter Property="Foreground" Value="#E4FFFA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#146655"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#062E26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DBA640"/>
            <Setter Property="Foreground" Value="#0B4539"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5B65A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B88A30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B4539"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="40"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#031C1C" Offset="0.0"/>
                <GradientStop Color="#063434" Offset="0.6"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="Auto"
                MaxWidth="800"
                Margin="20"
                Background="#FBFFFE"
                CornerRadius="30">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.25" Color="Black"/>
            </Border.Effect>

            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Text="Installation Setup"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#031C1C"
                               VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,10,0">

                    <StackPanel MaxWidth="550" HorizontalAlignment="Left">

                        <TextBlock x:Name="DescriptionText"
                                   Text="Please configure the initial settings to proceed with the installation."
                                   TextWrapping="Wrap"
                                   FontSize="16"
                                   Foreground="#546E6E"
                                   Margin="0,0,0,25"
                                   LineHeight="24"/>

                        <Border Background="#F0FDFA" 
                                BorderBrush="#CFF8F4"
                                BorderThickness="1"
                                CornerRadius="16" 
                                Padding="25"
                                Margin="0,0,0,25">
                            <StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock x:Name="LanguageLabelText" Text="Language" FontSize="15" FontWeight="SemiBold" Foreground="#031C1C"/>
                                    <TextBlock x:Name="LanguageDescText" Text="Select your preferred interface language." FontSize="13" Foreground="#546E6E" Margin="0,2,0,8"/>
                                    <ComboBox x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock x:Name="CompanyLabelText" Text="Company Tenant" FontSize="15" FontWeight="SemiBold" Foreground="#031C1C"/>
                                    <TextBlock x:Name="CompanyDescText" Text="Choose the workspace you belong to." FontSize="13" Foreground="#546E6E" Margin="0,2,0,8"/>
                                    <ComboBox x:Name="CompanyComboBox" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                    <CheckBox x:Name="DesktopShortcutCheckBox" 
                                              IsChecked="False" 
                                              VerticalAlignment="Center"
                                              Cursor="Hand">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                    <TextBlock x:Name="DesktopShortcutLabel" 
                                               Text="Create a shortcut on Desktop"
                                               VerticalAlignment="Center" 
                                               Margin="10,0,0,0" 
                                               FontSize="15"
                                               Foreground="#031C1C"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#DBA640" BorderThickness="2,0,0,0" Padding="10,0,0,0" Margin="0,0,0,30">
                            <TextBlock x:Name="NoteTextBlock"
                                       Text="Note: Administrator privileges may be required to complete these changes."
                                       FontSize="14"
                                       FontStyle="Italic"
                                       Foreground="#666"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="CancelButton"
                                    Grid.Column="0"
                                    Content="Cancel"
                                    Click="CancelButton_Click"
                                    Height="50"
                                    Style="{StaticResource SecondaryButtonStyle}"/>

                            <Button x:Name="ContinueButton"
                                    Grid.Column="2"
                                    Content="Continue"
                                    Click="ContinueButton_Click"
                                    Height="50"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
