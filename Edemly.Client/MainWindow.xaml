<Window x:Class="Edemly.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Edemly.Client.Controls"
        Title="Edemly" Height="768" Width="1300"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Branding/app-icon.ico"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <controls:ConnectionStatusBar x:Name="ConnectionStatusBar" Grid.Row="0" HorizontalAlignment="Stretch" Panel.ZIndex="100"/>

        <Frame x:Name="MainFrame" 
             Grid.Row="1"
             NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
