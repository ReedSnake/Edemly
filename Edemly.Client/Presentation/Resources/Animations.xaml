<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page slide in from right -->

    <Storyboard x:Key="PageSlideInFromRight">

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.3"
                                  Value="0">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.2"
                                  Value="1">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

    </Storyboard>

    <!-- Page slide out to left -->

    <Storyboard x:Key="PageSlideOutToLeft">

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.3"
                                  Value="-100">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.2"
                                  Value="0">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

    </Storyboard>

    <!-- Page slide in from left -->

    <Storyboard x:Key="PageSlideInFromLeft">

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.3"
                                  Value="0">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.2"
                                  Value="1">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

    </Storyboard>

    <!-- Page slide out to right -->

    <Storyboard x:Key="PageSlideOutToRight">

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.3"
                                  Value="100">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.2"
                                  Value="0">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

    </Storyboard>

    <!-- Fade in -->

    <Storyboard x:Key="FadeInAnimation">

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.4"
                                  Value="1">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

    </Storyboard>

    <!-- Fade out -->

    <Storyboard x:Key="FadeOutAnimation">

        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)">

            <EasingDoubleKeyFrame KeyTime="0:0:0.3"
                                  Value="0">

                <EasingDoubleKeyFrame.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </EasingDoubleKeyFrame.EasingFunction>

            </EasingDoubleKeyFrame>

        </DoubleAnimationUsingKeyFrames>

    </Storyboard>

</ResourceDictionary>