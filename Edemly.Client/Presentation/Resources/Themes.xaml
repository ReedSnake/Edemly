<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<LinearGradientBrush x:Key="ThemeGradientBrush"
                         StartPoint="1,1"
                         EndPoint="0,0">
		<GradientStop Color="{DynamicResource ThemeBackgroundDarkColor}"
                      Offset="0.7" />

		<GradientStop Color="{DynamicResource ThemePrimaryColor}"
                      Offset="0.0" />
	</LinearGradientBrush>

    <LinearGradientBrush x:Key="AuthPageBackgroundBrush"
                     StartPoint="0,0"
                     EndPoint="1,1">
        <GradientStop Color="{DynamicResource ThemeBackgroundDarkColor}" Offset="0.0" />
        <GradientStop Color="{DynamicResource ThemeSecondaryColor}" Offset="0.55" />
        <GradientStop Color="{DynamicResource ThemePrimaryColor}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PageBackgroundBrush"
                     StartPoint="1,1" 
                     EndPoint="0,0">
        <GradientStop Color="{DynamicResource ThemeBackgroundDarkColor}" Offset="0.7" />
        <GradientStop Color="{DynamicResource ThemePrimaryColor}" Offset="0.0" />
    </LinearGradientBrush>

</ResourceDictionary>
