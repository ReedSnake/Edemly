<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- Base border styles                                        -->
    <!-- ========================================================= -->

    <Style x:Key="BaseBorderStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource ThemeBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <Style x:Key="BasePanelBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Padding"
                Value="16" />
    </Style>


    <!-- ========================================================= -->
    <!-- Input borders                                             -->
    <!-- ========================================================= -->

    <Style x:Key="InputBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeInputBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeSecondaryBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="8" />
        <Setter Property="Padding"
                Value="10,4" />
    </Style>

    <Style x:Key="SearchInputBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource InputBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeInputBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="CornerRadius"
                Value="18" />
        <Setter Property="Padding"
                Value="12,6" />
    </Style>

    <Style x:Key="MessageInputBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="20" />
        <Setter Property="Padding"
                Value="8,4" />
    </Style>


    <!-- ========================================================= -->
    <!-- Settings / profile sections                               -->
    <!-- ========================================================= -->

    <Style x:Key="SettingsSectionBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BasePanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemePrimaryLightBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="15" />
        <Setter Property="Padding"
                Value="20" />
    </Style>

    <Style x:Key="SettingsCardBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BasePanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Padding"
                Value="14" />
    </Style>

    <Style x:Key="InfoValueBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceAltBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="8" />
        <Setter Property="Padding"
                Value="10,6" />
    </Style>

    <Style x:Key="ContactInfoBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource InfoValueBorderStyle}">
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="Padding"
                Value="12,8" />
    </Style>


    <!-- ========================================================= -->
    <!-- Notes                                                     -->
    <!-- ========================================================= -->

    <Style x:Key="NoteBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BasePanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemePrimaryLightBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Padding"
                Value="12" />
    </Style>

    <Style x:Key="CompactNoteBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource NoteBorderStyle}">
        <Setter Property="Padding"
                Value="8" />
        <Setter Property="CornerRadius"
                Value="10" />
    </Style>


    <!-- ========================================================= -->
    <!-- Dialog / popup panels                                     -->
    <!-- ========================================================= -->

    <Style x:Key="DialogPanelBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BasePanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeSecondaryBrush}" />
        <Setter Property="BorderThickness"
                Value="2" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Padding"
                Value="20" />
    </Style>

    <Style x:Key="PopupPanelBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BasePanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="14" />
        <Setter Property="Padding"
                Value="16" />
    </Style>

    <Style x:Key="FloatingPanelBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BasePanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="16" />
        <Setter Property="Padding"
                Value="16" />
    </Style>

    <Style x:Key="OverlayPanelBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BasePanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeSecondaryBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="16" />
        <Setter Property="Padding"
                Value="20" />
    </Style>


    <!-- ========================================================= -->
    <!-- Main page panels                                          -->
    <!-- ========================================================= -->

    <Style x:Key="ChatListItemBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="CornerRadius"
                Value="10" />
        <Setter Property="Padding"
                Value="10" />
    </Style>

    <Style x:Key="SearchResultsBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource FloatingPanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Padding"
                Value="8" />
    </Style>

    <Style x:Key="StickerPanelBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource FloatingPanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Padding"
                Value="10" />
    </Style>

    <Style x:Key="MessageBubbleBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="CornerRadius"
                Value="14" />
        <Setter Property="Padding"
                Value="10,7" />
    </Style>

    <Style x:Key="OwnMessageBubbleBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource MessageBubbleBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSecondaryBrush}" />
    </Style>

    <Style x:Key="OtherMessageBubbleBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource MessageBubbleBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
    </Style>


    <!-- ========================================================= -->
    <!-- Header / avatar / media borders                           -->
    <!-- ========================================================= -->

    <Style x:Key="AvatarBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemePrimaryLightBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeSecondaryBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="25" />
    </Style>

    <Style x:Key="HeaderBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
        <Setter Property="CornerRadius"
                Value="0" />
        <Setter Property="Padding"
                Value="15" />
    </Style>

    <Style x:Key="ImagePreviewBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="8" />
        <Setter Property="Padding"
                Value="4" />
    </Style>


    <!-- ========================================================= -->
    <!-- Call window borders                                       -->
    <!-- ========================================================= -->

    <Style x:Key="CallPanelBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BasePanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeSecondaryBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="16" />
        <Setter Property="Padding"
                Value="20" />
    </Style>

    <Style x:Key="CallOverlayPanelBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource OverlayPanelBorderStyle}">
        <Setter Property="CornerRadius"
                Value="18" />
        <Setter Property="Padding"
                Value="20" />
    </Style>


    <!-- ========================================================= -->
    <!-- Premium page borders                                      -->
    <!-- ========================================================= -->

    <Style x:Key="PremiumCardBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BasePanelBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemePrimaryLightBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="16" />
        <Setter Property="Padding"
                Value="20" />
    </Style>

    <Style x:Key="PremiumFeatureBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource BaseBorderStyle}">
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceAltBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Padding"
                Value="14" />
    </Style>


    <!-- ========================================================= -->
    <!-- Compatibility aliases                                     -->
    <!-- ========================================================= -->

    <Style x:Key="DialogBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource DialogPanelBorderStyle}" />

    <Style x:Key="FloatingPanelStyle"
           TargetType="Border"
           BasedOn="{StaticResource FloatingPanelBorderStyle}" />

    <Style x:Key="DialogPanelStyle"
           TargetType="Border"
           BasedOn="{StaticResource DialogPanelBorderStyle}" />

    <Style x:Key="SettingsSectionStyle"
           TargetType="Border"
           BasedOn="{StaticResource SettingsSectionBorderStyle}" />

</ResourceDictionary>
