<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- Base text styles                                          -->
    <!-- ========================================================= -->

    <Style x:Key="BaseTextBlockStyle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style x:Key="BaseSingleLineTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>


    <!-- ========================================================= -->
    <!-- Page / section titles                                     -->
    <!-- ========================================================= -->

    <Style x:Key="PageTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="28" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="24" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PanelTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseSingleLineTextBlockStyle}">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="DialogTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
    </Style>


    <!-- ========================================================= -->
    <!-- Body text                                                 -->
    <!-- ========================================================= -->

    <Style x:Key="BodyTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyBoldTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>

    <Style x:Key="MutedTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>

    <Style x:Key="SmallMutedTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource MutedTextStyle}">
        <Setter Property="FontSize"
                Value="12" />
    </Style>


    <!-- ========================================================= -->
    <!-- Form / field text                                         -->
    <!-- ========================================================= -->

    <Style x:Key="FieldLabelTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="Margin"
                Value="0,5,0,5" />
    </Style>

    <Style x:Key="InfoValueTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="InfoLabelTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextSecondaryBrush}" />
    </Style>


    <!-- ========================================================= -->
    <!-- Settings text                                             -->
    <!-- ========================================================= -->

    <Style x:Key="SettingsSectionTitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="Margin"
                Value="0,0,0,15" />
    </Style>

    <Style x:Key="SettingsSectionLabelStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="Margin"
                Value="0,0,0,8" />
    </Style>

    <Style x:Key="SettingsHintTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="Margin"
                Value="12,5,0,0" />
        <Setter Property="HorizontalAlignment"
                Value="Left" />
    </Style>

    <Style x:Key="SettingsIconTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseSingleLineTextBlockStyle}">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="0,0,8,0" />
    </Style>


    <!-- ========================================================= -->
    <!-- FAQ / about text                                          -->
    <!-- ========================================================= -->

    <Style x:Key="FaqQuestionTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>

    <Style x:Key="FaqAnswerTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Margin"
                Value="0,10,0,0" />
    </Style>

    <Style x:Key="AboutTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Margin"
                Value="0,0,0,20" />
    </Style>

    <Style x:Key="AboutTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PageTitleTextStyle}" />

    <Style x:Key="FaqTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SectionTitleTextStyle}" />


    <!-- ========================================================= -->
    <!-- Contact / profile text                                    -->
    <!-- ========================================================= -->

    <Style x:Key="ContactIconTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseSingleLineTextBlockStyle}">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="Margin"
                Value="0,0,8,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="ContactValueTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseSingleLineTextBlockStyle}">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>


    <!-- ========================================================= -->
    <!-- Calendar text                                             -->
    <!-- ========================================================= -->

    <Style x:Key="CalendarTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseSingleLineTextBlockStyle}">
        <Setter Property="FontSize"
                Value="22" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="CategoryTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>

    <Style x:Key="CategoryDescriptionTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="Opacity"
                Value="0.7" />
    </Style>


    <!-- ========================================================= -->
    <!-- Call window text                                          -->
    <!-- ========================================================= -->

    <Style x:Key="CallSectionTitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="Margin"
                Value="8" />
    </Style>


    <!-- ========================================================= -->
    <!-- Premium page text                                         -->
    <!-- ========================================================= -->

    <Style x:Key="PremiumTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextStyle}">
    </Style>

    <Style x:Key="PremiumFeatureTitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PremiumTextStyle}">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>

    <Style x:Key="PremiumFeatureDescriptionStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PremiumTextStyle}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Margin"
                Value="0,5,0,0" />
    </Style>

</ResourceDictionary>
