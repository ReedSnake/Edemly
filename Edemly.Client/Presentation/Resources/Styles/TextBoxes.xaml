<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- Base TextBox styles                                       -->
    <!-- ========================================================= -->

    <Style x:Key="BaseTextBoxStyle"
           TargetType="TextBox">
        <Setter Property="FontFamily"
                Value="{StaticResource DefaultFontFamily}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="10,6" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="CaretBrush"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="SelectionBrush"
                Value="{DynamicResource ThemePrimaryLightBrush}" />
    </Style>


    <!-- ========================================================= -->
    <!-- Rounded TextBox                                           -->
    <!-- ========================================================= -->

	<Style x:Key="RoundedTextBoxStyle"
       TargetType="TextBox"
       BasedOn="{StaticResource BaseTextBoxStyle}">
		<Setter Property="Background"
				Value="{DynamicResource ThemeInputBackgroundBrush}" />
		<Setter Property="BorderBrush"
				Value="{DynamicResource ThemeSecondaryBrush}" />
		<Setter Property="BorderThickness"
				Value="1" />
		<Setter Property="MinHeight"
				Value="36" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Border x:Name="TextBoxBorder"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="10">

						<Grid>
							<ScrollViewer x:Name="PART_ContentHost"
										  Margin="{TemplateBinding Padding}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

							<TextBlock x:Name="PlaceholderText"
									   Text="{TemplateBinding Tag}"
									   Foreground="Gray" 
									   Margin="{TemplateBinding Padding}"
									   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									   IsHitTestVisible="False" Visibility="Hidden" />
						</Grid>

					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}" />
							<Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="2" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.55" />
						</Trigger>
						<Trigger Property="IsReadOnly" Value="True">
							<Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.75" />
						</Trigger>

						<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
							<Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>


    <!-- ========================================================= -->
    <!-- Auth / login TextBox                                      -->
    <!-- ========================================================= -->

    <Style x:Key="AuthTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="FontSize"
                Value="16" />
        <Setter Property="Height"
                Value="45" />
        <Setter Property="Background"
                Value="{DynamicResource ThemeInputBackgroundBrush}" />
		<Setter Property="Padding" Value="14,0" />
		
		<Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeSecondaryBrush}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
    </Style>


    <!-- ========================================================= -->
    <!-- Input TextBox inside custom Border                        -->
    <!-- Use when the outer border is styled separately             -->
    <!-- ========================================================= -->

    <Style x:Key="InputTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource BaseTextBoxStyle}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Height"
                Value="24" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
    </Style>


    <!-- ========================================================= -->
    <!-- Search TextBox                                            -->
    <!-- ========================================================= -->

    <Style x:Key="SearchTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinHeight"
                Value="36" />
        <Setter Property="Padding"
                Value="12,6" />
        <Setter Property="Background"
                Value="{DynamicResource ThemeInputBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
    </Style>


    <!-- ========================================================= -->
    <!-- Dialog TextBox                                            -->
    <!-- ========================================================= -->

    <Style x:Key="DialogTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinHeight"
                Value="38" />
        <Setter Property="Padding"
                Value="12,7" />
        <Setter Property="Background"
                Value="{DynamicResource ThemeInputBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
    </Style>


    <!-- ========================================================= -->
    <!-- Settings TextBox                                          -->
    <!-- ========================================================= -->

    <Style x:Key="SettingsTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinHeight"
                Value="38" />
        <Setter Property="Padding"
                Value="12,7" />
        <Setter Property="Background"
                Value="{DynamicResource ThemeInputBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>


    <!-- ========================================================= -->
    <!-- Group name TextBox                                        -->
    <!-- ========================================================= -->

    <Style x:Key="GroupNameTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinHeight"
                Value="44" />
        <Setter Property="Padding"
                Value="12,10" />
        <Setter Property="Background"
                Value="{DynamicResource ThemeInputBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
        <Setter Property="TextAlignment"
                Value="Left" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="AcceptsReturn"
                Value="False" />
        <Setter Property="MinLines"
                Value="1" />
        <Setter Property="MaxLines"
                Value="2" />
        <Setter Property="HorizontalScrollBarVisibility"
                Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility"
                Value="Disabled" />
    </Style>


    <!-- ========================================================= -->
    <!-- Message input TextBox                                     -->
    <!-- Keep events on concrete TextBox in Page_main.xaml          -->
    <!-- ========================================================= -->

    <Style x:Key="MessageInputTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource BaseTextBoxStyle}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="Padding"
                Value="8,6" />
        <Setter Property="MinHeight"
                Value="34" />
        <Setter Property="MaxHeight"
                Value="120" />
        <Setter Property="AcceptsReturn"
                Value="True" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility"
                Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility"
                Value="Disabled" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
    </Style>


    <!-- ========================================================= -->
    <!-- Multiline TextBox                                         -->
    <!-- ========================================================= -->

    <Style x:Key="MultilineTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="MinHeight"
                Value="80" />
        <Setter Property="Padding"
                Value="12,8" />
        <Setter Property="AcceptsReturn"
                Value="True" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility"
                Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility"
                Value="Disabled" />
        <Setter Property="VerticalContentAlignment"
                Value="Top" />
    </Style>


    <!-- ========================================================= -->
    <!-- Compact TextBox                                           -->
    <!-- ========================================================= -->

    <Style x:Key="CompactTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="MinHeight"
                Value="30" />
        <Setter Property="Padding"
                Value="10,4" />
    </Style>


    <!-- ========================================================= -->
    <!-- Readonly TextBox                                          -->
    <!-- ========================================================= -->

    <Style x:Key="ReadonlyTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="IsReadOnly"
                Value="True" />
        <Setter Property="Background"
                Value="{DynamicResource ThemeSurfaceAltBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeBorderBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextSecondaryBrush}" />
        <Setter Property="Cursor"
                Value="Arrow" />
    </Style>


    <!-- ========================================================= -->
    <!-- Calendar TextBox                                          -->
    <!-- ========================================================= -->

    <Style x:Key="CalendarTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource RoundedTextBoxStyle}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="MinHeight"
                Value="36" />
        <Setter Property="Padding"
                Value="12,6" />
        <Setter Property="Background"
                Value="{DynamicResource ThemeInputBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource ThemeSecondaryBrush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>


    <!-- ========================================================= -->
    <!-- Compatibility aliases                                     -->
    <!-- ========================================================= -->

    <Style x:Key="RoundedSearchTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource SearchTextBoxStyle}" />

</ResourceDictionary>
