<common:ThemedWindow x:Class="Edemly.Client.Presentation.Dialogs.Attachments.AttachmentPreviewDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
                     Title="AttachmentPreviewDialog"
                     Width="620"
                     Height="560"
                     MinWidth="520"
                     MinHeight="500"
                     WindowStartupLocation="CenterOwner"
                     ResizeMode="CanResize"
                     Background="Transparent"
                     AllowsTransparency="True"
                     WindowStyle="None">

    <Border Background="{DynamicResource ThemeSurfaceBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="20"
            Effect="{StaticResource DialogShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,16">
                <TextBlock x:Name="DialogTitleText"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                <TextBlock x:Name="DialogHintText"
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource ThemeSurfaceAltBrush}"
                    BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           MaxHeight="250"
                           Visibility="Collapsed" />

                    <StackPanel x:Name="PreviewPlaceholderPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="84"
                                Height="84"
                                CornerRadius="42"
                                Background="{DynamicResource ThemePrimaryBrush}">
                            <TextBlock x:Name="PreviewIconText"
                                       FontSize="36"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ThemeOnPrimaryTextBrush}" />
                        </Border>

                        <TextBlock x:Name="PreviewUnavailableText"
                                   Margin="0,14,0,0"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,16">
                <Border Background="{DynamicResource ThemeInputBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="FileNameText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="FileMetaText"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CaptionLabelText"
                           Margin="0,0,0,8"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}" />

                <Border Background="{DynamicResource ThemeInputBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="8">
                    <TextBox x:Name="CaptionTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="96"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                             VerticalScrollBarVisibility="Auto" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RemoveButton"
                        Grid.Column="0"
                        MinWidth="110"
                        Height="42"
                        Margin="0,0,12,0"
                        Click="RemoveButton_Click" />

                <Button x:Name="CancelButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryDialogButtonStyle}"
                        MinWidth="110"
                        Height="42"
                        Margin="0,0,12,0"
                        Click="CancelButton_Click" />

                <Button x:Name="SendButton"
                        Grid.Column="3"
                        Style="{StaticResource PrimaryDialogButtonStyle}"
                        MinWidth="110"
                        Height="42"
                        Click="SendButton_Click" />
            </Grid>
        </Grid>
    </Border>
</common:ThemedWindow>
