<common:ThemedPage x:Class="Edemly.Client.Presentation.Pages.Info.Page_aboutapp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1280"
      Title="About Edemly"
      Background="{DynamicResource PageBackgroundBrush}">

    <common:ThemedPage.Resources>

        <Style x:Key="FaqCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource BaseBorderStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
            <Setter Property="Padding" Value="15" />
        </Style>

        <Style x:Key="FaqExpanderStyle"
               TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="AboutBackButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Panel.ZIndex" Value="1000" />
        </Style>

    </common:ThemedPage.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Rectangle Fill="{DynamicResource ThemeSurfaceBrush}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Margin="40,20"
                   RadiusX="40"
                   RadiusY="40" />

        <Grid Margin="40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="BackButton"
                        Grid.Row="0"
                        Content="←"
                        Width="40"
                        Height="40"
                        Margin="30,13,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Style="{StaticResource AboutBackButtonStyle}"
                        Click="Back_Click" />

                <ScrollViewer Grid.Row="1"
                              Margin="40,18,40,8"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>
                        <TextBlock x:Name="GreetingText"
                                   Text="Hi, dear user!"
                                   Style="{StaticResource AboutTitleTextStyle}" />

                        <TextBlock x:Name="WelcomeText"
                                   Text="We are the Edemly team, and we are happy to welcome you to our messenger!"
                                   Style="{StaticResource AboutTextStyle}" />

                        <TextBlock x:Name="GoalText"
                                   Text="Our goal is to create a space where communication and planning complement each other organically. We believe that modern people need not just another messenger, but a tool that helps them not only stay connected, but also manage their time effectively."
                                   Style="{StaticResource AboutTextStyle}"
                                   Margin="0,0,0,40" />

                        <TextBlock x:Name="FaqTitleText"
                                   Text="FAQs:"
                                   Style="{StaticResource FaqTitleTextStyle}" />

                        <Border Style="{StaticResource FaqCardStyle}">
                            <Expander x:Name="expanderContact"
                                      Style="{StaticResource FaqExpanderStyle}">

                                <Expander.Header>
                                    <TextBlock x:Name="FaqContactQuestionText"
                                               Text="How do I add a new contact?"
                                               Style="{StaticResource FaqQuestionTextStyle}" />
                                </Expander.Header>

                                <TextBlock x:Name="FaqContactAnswerText"
                                           Text="Use the search function in the main menu. Enter the user's name or email address, and you can start chatting."
                                           Style="{StaticResource FaqAnswerTextStyle}" />
                            </Expander>
                        </Border>

                        <Border Style="{StaticResource FaqCardStyle}">
                            <Expander x:Name="expanderTheme"
                                      Style="{StaticResource FaqExpanderStyle}">

                                <Expander.Header>
                                    <TextBlock x:Name="FaqThemeQuestionText"
                                               Text="How do I customize the theme?"
                                               Style="{StaticResource FaqQuestionTextStyle}" />
                                </Expander.Header>

                                <TextBlock x:Name="FaqThemeAnswerText"
                                           Text="Go to the main menu and select 'Settings.' There you will find various design options to suit your taste."
                                           Style="{StaticResource FaqAnswerTextStyle}" />
                            </Expander>
                        </Border>

                        <Border Style="{StaticResource FaqCardStyle}">
                            <Expander x:Name="expanderScheduler"
                                      Style="{StaticResource FaqExpanderStyle}">

                                <Expander.Header>
                                    <TextBlock x:Name="FaqSchedulerQuestionText"
                                               Text="How does the task scheduler work?"
                                               Style="{StaticResource FaqQuestionTextStyle}" />
                                </Expander.Header>

                                <TextBlock x:Name="FaqSchedulerAnswerText"
                                           Text="You can create tasks and set deadlines. All tasks are synchronized with your calendar so you can see the full picture of your activities."
                                           Style="{StaticResource FaqAnswerTextStyle}" />
                            </Expander>
                        </Border>

                        <Border Style="{StaticResource FaqCardStyle}"
                                Margin="0,0,0,20">

                            <Expander x:Name="expanderSupport"
                                      Style="{StaticResource FaqExpanderStyle}">

                                <Expander.Header>
                                    <TextBlock x:Name="FaqSupportQuestionText"
                                               Text="How do I contact support?"
                                               Style="{StaticResource FaqQuestionTextStyle}" />
                                </Expander.Header>

                                <TextBlock x:Name="FaqSupportAnswerText"
                                           Style="{StaticResource FaqAnswerTextStyle}">

                                    <Run x:Name="SupportAnswerRun"
                                         Text="If you have any questions or problems, please contact us using the form: " />

                                    <Hyperlink NavigateUri="https://docs.google.com/forms/d/e/1FAIpQLSdeL8Op6FNEp8r7vSrzEjooGSJfk8tPqKFfNoR8gPEHN9EOqA/viewform?usp=dialog"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run x:Name="SupportLinkRun"
                                             Text="Click here" />
                                    </Hyperlink>
                                </TextBlock>
                            </Expander>
                        </Border>

                        <TextBlock x:Name="ClosingText"
                                   Text="We create Edemly with you in mind. Every feature is designed to make your life easier and more organized."
                                   Style="{StaticResource AboutTextStyle}" />

                        <TextBlock x:Name="ThanksText"
                                   Text="Thank you for choosing us!"
                                   Style="{StaticResource AboutTextStyle}"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</common:ThemedPage>
