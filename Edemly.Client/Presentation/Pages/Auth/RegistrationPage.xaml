<common:ThemedPage x:Class="Edemly.Client.Presentation.Pages.Auth.RegistrationPage"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:lang="clr-namespace:Edemly.Client.Application.Localization"
                   xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
                   mc:Ignorable="d"
                   d:DesignHeight="720"
                   d:DesignWidth="1280"
                   Title="Page_registration">

    <Grid Background="{DynamicResource AuthPageBackgroundBrush}"
          RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*" />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>

        <Button Content="Exit"
                Style="{StaticResource LightButtonStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8"
                Width="150"
                Height="40"
                Panel.ZIndex="1"
                Click="ExitButton_Click" />

        <Image Grid.Column="0"
               Grid.ColumnSpan="2"
               Source="/Assets/PageIllustrations/auth-register.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Left"
               Margin="80,0,0,0"
               Panel.ZIndex="0"
               RenderTransformOrigin="0.5,0.5" />

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="300,0,100,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20">

                <Image Source="/Assets/Branding/logo.png"
                       Width="64"
                       Height="53"
                       VerticalAlignment="Center" />

                <TextBlock Text="Edemly"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontSize="36"
                           FontFamily="{StaticResource BrandFontFamily}"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Left"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontSize="36"
                       FontFamily="{StaticResource BrandFontFamily}"
                       Margin="0,0,0,20">

                <Run Text="{x:Static lang:DefaultLanguage.RegistrationTitleLine1}" />
                <LineBreak />
                <Run Text="{x:Static lang:DefaultLanguage.RegistrationTitleLine2}" />
            </TextBlock>

            <Viewbox Stretch="Uniform"
                     MaxWidth="400"
                     HorizontalAlignment="Left">

                <StackPanel Width="300"
                            Margin="0,0,0,20">

                    <TextBlock Text="{x:Static lang:DefaultLanguage.UserNameLabel}"
                               Style="{StaticResource MutedTextStyle}"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               HorizontalAlignment="Left"
                               FontSize="16"
                               Opacity="0.9"
                               Margin="0,0,0,5" />

                    <TextBox x:Name="FullNameTextBox"
                             Style="{StaticResource AuthTextBoxStyle}"
                             Margin="0,0,0,15"
                             Padding="5 0"
                             TextChanged="FullNameTextBox_TextChanged"
                             KeyDown="TextBox_KeyDown"
                             Tag="{x:Static lang:DefaultLanguage.UsernamePlaceholder}"/>

                    <TextBlock Text="{x:Static lang:DefaultLanguage.RegistrationEmailLabel}"
                               Style="{StaticResource MutedTextStyle}"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               HorizontalAlignment="Left"
                               FontSize="16"
                               Opacity="0.9"
                               Margin="0,0,0,5" />

                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource AuthTextBoxStyle}"
                             Margin="0,0,0,20"
                             Padding="5 0"
                             KeyDown="TextBox_KeyDown" 
                             Tag="{x:Static lang:DefaultLanguage.EmailPlaceholder}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <CheckBox x:Name="TermsCheckBox"
                                  VerticalAlignment="Top"
                                  Margin="0,0,8,0" />

                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource MutedTextStyle}"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.9">

                            <Run Text="{x:Static lang:DefaultLanguage.TermsLine1}" />
                            <LineBreak />

                            <Hyperlink Click="OpenPolicies_Click">
                                <Run Text="{x:Static lang:DefaultLanguage.TermsLine2}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,20">

                        <CheckBox x:Name="RememberMeCheckBox"
                                  VerticalAlignment="Top"
                                  Margin="0,0,8,0" />

                        <TextBlock Text="{x:Static lang:DefaultLanguage.RememberMe}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.9" />
                    </StackPanel>

                    <Button x:Name="SignUpButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{x:Static lang:DefaultLanguage.SignUpButton}"
                            Height="45"
                            Margin="0,0,0,15"
                            Click="SignUpButton_Click" />

                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               FontSize="14"
                               MouseLeftButtonDown="SignInText_MouseLeftButtonDown">

                        <Run Text="{x:Static lang:DefaultLanguage.AlreadyHaveAccount}" />

                        <Run Text="{x:Static lang:DefaultLanguage.SignIn}"
                             Foreground="{DynamicResource ThemePrimaryLightBrush}"
                             FontWeight="Bold"
                             Cursor="Hand" />
                    </TextBlock>
                </StackPanel>
            </Viewbox>
        </StackPanel>

        <Border x:Name="PoliciesPanel"
                Grid.ColumnSpan="2"
                Background="{DynamicResource ThemeOverlayBrush}"
                Visibility="Collapsed">

            <Grid Width="900"
                  Height="600"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Border Background="{DynamicResource ThemeSurfaceBrush}"
                        CornerRadius="8"
                        Padding="16">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="PoliciesTitleText"
                                   Grid.Row="0"
                                   Text="{x:Static lang:DefaultLanguage.PoliciesTitle}"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,8" />

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Hidden">

                            <TextBlock x:Name="PoliciesContentText"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13" />
                        </ScrollViewer>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">

                            <Button x:Name="ClosePoliciesButton"
                                    Content="{x:Static lang:DefaultLanguage.PoliciesClose}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="ClosePolicies_Click" />

                            <Button x:Name="AcceptPoliciesButton"
                                    Content="{x:Static lang:DefaultLanguage.PoliciesAccept}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="AcceptPolicies_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</common:ThemedPage>
