<common:ThemedPage x:Class="Edemly.Client.Presentation.Pages.Auth.VerificationPage"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:lang="clr-namespace:Edemly.Client.Application.Localization"
                   xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
                   mc:Ignorable="d"
                   d:DesignHeight="720"
                   d:DesignWidth="1280"
                   Title="VerificationPage">

    <Grid Background="{DynamicResource AuthPageBackgroundBrush}"
          RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*" />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0"
               Grid.ColumnSpan="2"
               Source="/Assets/PageIllustrations/verification-primary.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Left"
               VerticalAlignment="Stretch"
               MaxWidth="1157"
               RenderTransformOrigin="0.5,0.5" />

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="250,0,100,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,30">

                <Image Source="/Assets/Branding/logo.png"
                       Width="64"
                       Height="53"
                       VerticalAlignment="Center" />

                <TextBlock Text="Edemly"
                           Foreground="{DynamicResource ThemeOnPrimaryTextBrush}"
                           FontSize="36"
                           FontFamily="{StaticResource BrandFontFamily}"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0" />
            </StackPanel>

            <TextBlock Text="{x:Static lang:DefaultLanguage.VerificationTitle}"
                       Foreground="{DynamicResource ThemeOnPrimaryTextBrush}"
                       FontSize="40"
                       FontWeight="Bold"
                       FontFamily="{StaticResource BrandFontFamily}"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,20" />

            <TextBlock Text="{x:Static lang:DefaultLanguage.VerificationDescription}"
                       Foreground="{DynamicResource ThemeOnPrimaryTextBrush}"
                       FontSize="16"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Left"
                       Width="400"
                       Margin="0,0,0,30" />

            <StackPanel HorizontalAlignment="Left"
                        Width="300"
                        Margin="0,0,0,20">

                <TextBlock HorizontalAlignment="Left"
                           Foreground="{DynamicResource ThemeOnPrimaryTextBrush}"
                           FontSize="14"
                           Margin="0,0,0,20"
                           MouseLeftButtonDown="ResendText_MouseLeftButtonDown">

                    <Run Text="{x:Static lang:DefaultLanguage.ResendPrompt}" />
                    <LineBreak />

                    <Run Text="{x:Static lang:DefaultLanguage.ResendAction}"
                         Foreground="{DynamicResource ThemePrimaryLightBrush}"
                         FontWeight="Bold"
                         Cursor="Hand" />
                </TextBlock>

                <TextBox x:Name="CodeTextBox"
                         Style="{StaticResource RoundedTextBoxStyle}"
                         Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                         CaretBrush="{DynamicResource ThemeTextPrimaryBrush}"
                         BorderBrush="{DynamicResource ThemeSecondaryBrush}"
                         BorderThickness="1.5"
                         MaxLength="6"
                         Margin="0,0,0,20"
                         KeyDown="CodeTextBox_KeyDown" />

                <Button x:Name="VerifyButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{x:Static lang:DefaultLanguage.VerifyButton}"
                        Background="{DynamicResource ThemeSurfaceBrush}"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                        Height="45"
                        Margin="0,0,0,20"
                        Click="VerifyButton_Click" />

                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource ThemeOnPrimaryTextBrush}"
                           FontSize="14"
                           MouseLeftButtonDown="BackToLoginText_MouseLeftButtonDown">

                    <Run Text="{x:Static lang:DefaultLanguage.BackToLoginText}" />

                    <Run Text="{x:Static lang:DefaultLanguage.BackToLoginAction}"
                         Foreground="{DynamicResource ThemePrimaryLightBrush}"
                         FontWeight="Bold"
                         Cursor="Hand" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</common:ThemedPage>
