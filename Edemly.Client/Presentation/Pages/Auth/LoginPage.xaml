<common:ThemedPage x:Class="Edemly.Client.Presentation.Pages.Auth.LoginPage"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:lang="clr-namespace:Edemly.Client.Application.Localization"
                   xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
                   mc:Ignorable="d"
                   d:DesignHeight="720"
                   d:DesignWidth="1280"
                   Title="LoginPage">

    <Grid Background="{DynamicResource AuthPageBackgroundBrush}"
          RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*" />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>

        <Button Content="Exit"
                Style="{StaticResource LightButtonStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8"
                Width="150"
                Panel.ZIndex="1"
                Height="40"
                Click="ExitButton_Click" />

        <Image Grid.Column="0"
               Grid.ColumnSpan="2"
               Source="/Assets/PageIllustrations/auth-login.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Left"
               Margin="80,0,0,0"
               Panel.ZIndex="0"
               RenderTransformOrigin="0.5,0.5" />

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="300,0,100,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,30">

                <Image Source="/Assets/Branding/logo.png"
                       Width="64"
                       Height="53"
                       VerticalAlignment="Center" />

                <TextBlock Text="Edemly"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontSize="36"
                           FontFamily="{StaticResource BrandFontFamily}"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0" />
            </StackPanel>

            <TextBlock Text="{x:Static lang:DefaultLanguage.WelcomeTitle}"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontSize="36"
                       FontFamily="{StaticResource BrandFontFamily}"
                       Margin="0,0,0,30" />

            <Viewbox Stretch="Uniform"
                     MaxWidth="400"
                     HorizontalAlignment="Left">

                <StackPanel Width="300"
                            Margin="0,0,0,20">

                    <TextBlock Text="{x:Static lang:DefaultLanguage.LoginEmailLabel}"
                               Style="{StaticResource MutedTextStyle}"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               HorizontalAlignment="Left"
                               FontSize="16"
                               Opacity="0.9"
                               Margin="0,0,0,5" />

                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource AuthTextBoxStyle}"
                             Margin="0,0,0,20"
                             Padding="5 0"
                             KeyDown="EmailTextBox_KeyDown" 
                             Tag="{x:Static lang:DefaultLanguage.EmailPlaceholder}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,20">

                        <CheckBox x:Name="RememberMeCheckBox"
                                  VerticalAlignment="Top"
                                  Margin="0,0,8,0"
                                  IsChecked="True" />

                        <TextBlock Text="{x:Static lang:DefaultLanguage.RememberMe}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.9" />
                    </StackPanel>

                    <Button x:Name="LoginButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{x:Static lang:DefaultLanguage.LoginButton}"
                            Height="45"
                            Margin="0,0,0,15"
                            Click="LoginButton_Click" />

                    <TextBlock x:Name="SignUpText"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               FontSize="14"
                               MouseLeftButtonDown="SignUpText_MouseLeftButtonDown">

                        <Run Text="{x:Static lang:DefaultLanguage.NoAccount}" />

                        <Run Text="{x:Static lang:DefaultLanguage.SignUp}"
                             Foreground="{DynamicResource ThemePrimaryLightBrush}"
                             FontWeight="Bold"
                             Cursor="Hand" />
                    </TextBlock>
                </StackPanel>
            </Viewbox>
        </StackPanel>
    </Grid>
</common:ThemedPage>
