<common:ThemedPage x:Class="Edemly.Client.Presentation.Pages.Payments.Page_premium"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1280"
      Title="Edemly Premium">

    <common:ThemedPage.Resources>
        <Style x:Key="PremiumFeatureItemStyle"
               TargetType="StackPanel"
               BasedOn="{StaticResource PremiumContentPanelStyle}">
            <Setter Property="Margin" Value="0,0,0,15" />
        </Style>

        <Style x:Key="PremiumFeaturesContainerStyle"
               TargetType="Border"
               BasedOn="{StaticResource PremiumCardBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceAltBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="PremiumSubscribeButtonBaseStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonBaseStyle}">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>

        <Style x:Key="PremiumMonthlyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>

        <Style x:Key="PremiumYearlyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>
    </common:ThemedPage.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Border Margin="20"
                Background="{DynamicResource ThemeSurfaceBrush}"
                CornerRadius="40" />

        <Grid Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"
                                  MinWidth="350" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Padding="10"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Style="{StaticResource PremiumContentPanelStyle}">
                    <Button x:Name="BackButton"
                            Style="{StaticResource BackButtonStyle}"
                            Content="←"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,20"
                            Click="Back_Click" />

                    <TextBlock x:Name="MainTitleText"
                               Style="{StaticResource PageTitleTextStyle}"
                               Text="Edemly Premium — More opportunities for you!"
                               Margin="0,0,0,10" />

                    <TextBlock x:Name="DescriptionText"
                               Style="{StaticResource PremiumTextStyle}"
                               Text="Want to use Edemly to its full potential? Upgrade to Premium and get advanced planning and organization features!"
                               Margin="0,0,0,20" />

                    <TextBlock x:Name="WhatIncludedText"
                               Style="{StaticResource BodyBoldTextStyle}"
                               Text="What is included in Premium?"
                               FontSize="20"
                               Margin="0,0,0,10" />

                    <Border Style="{StaticResource PremiumFeaturesContainerStyle}">
                        <StackPanel Style="{StaticResource PremiumContentPanelStyle}">
                            <StackPanel Style="{StaticResource PremiumFeatureItemStyle}">
                                <TextBlock x:Name="Feature1TitleText"
                                           Style="{StaticResource PremiumFeatureTitleStyle}"
                                           Text="📝 Unlimited notes" />

                                <TextBlock x:Name="Feature1DescText"
                                           Style="{StaticResource PremiumFeatureDescriptionStyle}"
                                           Text="The free version offers a limited number of notes. With Premium, you can create as many notes as you need — for work, study, personal matters, and creative ideas." />
                            </StackPanel>

                            <StackPanel Style="{StaticResource PremiumFeatureItemStyle}">
                                <TextBlock x:Name="Feature2TitleText"
                                           Style="{StaticResource PremiumFeatureTitleStyle}"
                                           Text="⏰ Advanced reminder system" />

                                <TextBlock x:Name="Feature2DescText"
                                           Style="{StaticResource PremiumFeatureDescriptionStyle}"
                                           Text="Create an unlimited number of reminders with flexible settings." />
                            </StackPanel>

                            <StackPanel Style="{StaticResource PremiumFeatureItemStyle}">
                                <TextBlock x:Name="Feature3TitleText"
                                           Style="{StaticResource PremiumFeatureTitleStyle}"
                                           Text="🎨 Exclusive themes" />

                                <TextBlock x:Name="Feature3DescText"
                                           Style="{StaticResource PremiumFeatureDescriptionStyle}"
                                           Text="Access premium themes and fine-tune the interface to suit your style." />
                            </StackPanel>

                            <StackPanel Style="{StaticResource PremiumFeatureItemStyle}">
                                <TextBlock x:Name="Feature4TitleText"
                                           Style="{StaticResource PremiumFeatureTitleStyle}"
                                           Text="⚡ Priority support" />

                                <TextBlock x:Name="Feature4DescText"
                                           Style="{StaticResource PremiumFeatureDescriptionStyle}"
                                           Text="Your questions will be handled first — we are always ready to help our users." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="NoteText"
                               Style="{StaticResource PremiumFeatureDescriptionStyle}"
                               FontStyle="Italic"
                               Text="*After your subscription ends, you will retain an unlimited number of notes."
                               Margin="0,0,0,20" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="MonthlyButton"
                                Grid.Column="0"
                                Style="{StaticResource PremiumMonthlyButtonStyle}"
                                Content="SUBSCRIBE FOR 2$/MONTH"
                                Click="MonthlyButton_Click" />

                        <Button x:Name="YearlyButton"
                                Grid.Column="2"
                                Style="{StaticResource PremiumYearlyButtonStyle}"
                                Content="SUBSCRIBE FOR 10$/YEAR"
                                Click="YearlyButton_Click" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Image Grid.Column="1"
                   Source="/Assets/PageIllustrations/premium-panel.png"
                   Margin="8,68,3,-4" />
        </Grid>
    </Grid>
</common:ThemedPage>
