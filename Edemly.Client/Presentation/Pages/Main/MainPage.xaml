<common:ThemedPage x:Class="Edemly.Client.Presentation.Pages.Main.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="MainPage"
      d:DesignHeight="720"
      d:DesignWidth="1280"
      PreviewMouseWheel="Page_PreviewMouseWheel">

    <common:ThemedPage.Resources>
        <Style x:Key="PlannerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButton12Style}">
            <Setter Property="Height" Value="58" />
            <Setter Property="Width" Value="277" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-3" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect" Value="{StaticResource ButtonShadowEffect}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlannerButtonTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource BodyBoldTextStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="237" />
        </Style>

        <Style x:Key="PageChatActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ChatActionButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PageFloatingPanelStyle"
               TargetType="Border"
               BasedOn="{StaticResource FloatingPanelStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource FloatingPanelShadowEffect}" />
        </Style>

        <Style x:Key="PageDialogPanelStyle"
               TargetType="Border"
               BasedOn="{StaticResource PageFloatingPanelStyle}">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Panel.ZIndex" Value="2000" />
            <Setter Property="Effect" Value="{StaticResource DialogShadowEffect}" />
        </Style>

        <Style x:Key="CollapsedNoteBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource InfoValueBorderStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="ChatInputBorderStyle"
               TargetType="Border"
               BasedOn="{StaticResource MessageInputBorderStyle}">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryLightBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HeaderOnPrimaryTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource BaseSingleLineTextBlockStyle}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnSecondaryTextBrush}" />
        </Style>

        <Style x:Key="NoteValueTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource InfoValueTextStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="20" />
        </Style>
    </common:ThemedPage.Resources>

    <Grid x:Name="MainGrid"
          ClipToBounds="True"
          VerticalAlignment="Stretch"
          Background="{DynamicResource PageBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="300" MinWidth="250" MaxWidth="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="Transparent"
                Padding="0"
                Panel.ZIndex="1">
            <Grid x:Name="LeftGrid" Margin="20,30,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MenuButton"
                            Grid.Column="0"
                            Style="{StaticResource RoundedButton12Style}"
                            Content="☰"
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Background="{DynamicResource ThemeSecondaryBrush}"
                            Foreground="{DynamicResource ThemeOnSecondaryTextBrush}"
                            Click="MenuButton_Click" />

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             Style="{StaticResource RoundedSearchTextBoxStyle}"
                             HorizontalAlignment="Left"
                             Margin="12,0,0,0"
                             Width="208"
                             MinWidth="120"
                             MaxWidth="260"
                             Height="60"
                             TextAlignment="Left" />
                </Grid>

                <Button x:Name="MyPlannerButton"
                        Grid.Row="1"
                        Margin="3,20,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource PlannerButtonStyle}"
                        Click="MyPlannerButton_Click">
                    <TextBlock x:Name="MyPlannerButtonText"
                               Style="{StaticResource PlannerButtonTextStyle}"
                               Text="My planer" />
                </Button>

                <Border Grid.Row="2"
                        HorizontalAlignment="Left"
                        Margin="3,20,0,20"
                        VerticalAlignment="Stretch"
                        Width="277"
                        Background="{DynamicResource ThemeSurfaceBrush}"
                        CornerRadius="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,15,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ChatsHeaderText"
                                       Grid.Column="0"
                                       Style="{StaticResource BodyBoldTextStyle}"
                                       Text="Chats"
                                       FontSize="18"
                                       HorizontalAlignment="Left"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center" />

                            <Button x:Name="CreateGroupButton"
                                    Grid.Column="1"
                                    Style="{StaticResource RoundedButtonStyle}"
                                    Content="+"
                                    Width="30"
                                    Padding="0"
                                    Height="30"
                                    Background="{DynamicResource ThemeSecondaryBrush}"
                                    Foreground="{DynamicResource ThemeOnSecondaryTextBrush}"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Click="CreateGroupButton_Click"
                                    Margin="0,0,10,0"
                                    ToolTip="Create Group" />
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Hidden"
                                      Padding="0"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ChatsPanel"
                                        Orientation="Vertical"
                                        MaxWidth="257"
                                        HorizontalAlignment="Stretch"
                                        Margin="10,0,10,10" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource ThemeSurfaceBrush}"
                CornerRadius="40"
                Margin="20"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Panel.ZIndex="0">

            <Grid x:Name="RightGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="123*" />
                    <RowDefinition Height="331*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Grid.RowSpan="4"
                        CornerRadius="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Panel.ZIndex="1"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <ImageBrush ImageSource="{DynamicResource BackgroundImage}"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <Border x:Name="ChatHeaderContainer"
                        Grid.Row="0"
                        Height="81"
                        Margin="20,20,20,0"
                        Background="{DynamicResource ThemeSecondaryBrush}"
                        VerticalAlignment="Top"
                        CornerRadius="25"
                        Panel.ZIndex="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Border x:Name="ChatHeaderAvatarBorder"
                                    Width="53"
                                    Height="53"
                                    CornerRadius="26.5"
                                    BorderBrush="{DynamicResource ThemeOnSecondaryTextBrush}"
                                    BorderThickness="2"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <ImageBrush x:Name="ChatHeaderAvatarBackground"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                <TextBlock x:Name="ChatHeaderText"
                                           Style="{StaticResource HeaderOnPrimaryTextStyle}"
                                           Text=""
                                           Visibility="Collapsed" />

                                <StackPanel x:Name="OnlineStatusPanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,4,0,0"
                                            Visibility="Collapsed">
                                    <Ellipse x:Name="OnlineIndicator"
                                             Width="10"
                                             Height="10"
                                             Fill="{DynamicResource ThemeDisabledTextBrush}"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center" />

                                    <TextBlock x:Name="StatusText"
                                               Style="{StaticResource SmallMutedTextStyle}"
                                               Text="Offline"
                                               Foreground="{DynamicResource ThemeOnSecondaryTextBrush}"
                                               Opacity="0.85"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="2"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="CallButton"
                                        Style="{StaticResource TransparentIconButtonStyle}"
                                        Content="📞"
                                        Width="40"
                                        Height="40"
                                        Foreground="{DynamicResource ThemeOnSecondaryTextBrush}"
                                        FontSize="16"
                                        Click="CallButton_Click"
                                        ToolTip="Start call"
                                        Margin="0,0,6,0" />

                                <Button x:Name="ContactMenuButton"
                                        Style="{StaticResource TransparentIconButtonStyle}"
                                        Content="⋯"
                                        Width="40"
                                        Height="40"
                                        Foreground="{DynamicResource ThemeOnSecondaryTextBrush}"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Click="ContactMenuButton_Click"
                                        Visibility="Visible"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <SkewTransform />
                                            <RotateTransform Angle="90.635" />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Button.RenderTransform>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Grid.RowSpan="3"
                      Margin="20,68,20,91"
                      Panel.ZIndex="2">
                    <ScrollViewer x:Name="MessagesScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  Padding="0"
                                  PanningMode="VerticalFirst"
                                  PreviewMouseWheel="MessagesScrollViewer_PreviewMouseWheel">
                        <StackPanel x:Name="MessagesPanel"
                                    Orientation="Vertical" />
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3"
                        VerticalAlignment="Top"
                        CornerRadius="0,0,40,40"
                        Margin="20,24,20,0"
                        Padding="10"
                        Background="Transparent"
                        Panel.ZIndex="2"
                        Height="91">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AttachFileButton"
                                Grid.Column="0"
                                Style="{StaticResource PageChatActionButtonStyle}"
                                Click="AttachFileButton_Click"
                                ToolTip="Attach file"
                                Padding="0">
                            <Button.Content>
                                <Viewbox Width="24" Height="24">
                                    <Path Fill="{DynamicResource ThemePrimaryBrush}"
                                          Stretch="Uniform"
                                          Data="M17.1459084,11.1469857 C17.3408728,10.9514263 17.6574549,10.9509439 17.8530143,11.1459084 C18.0485737,11.3408728 18.0490561,11.6574549 17.8540916,11.8530143 L11.9096172,17.8156301 C10.3312795,19.3987845 7.7683837,19.4026893 6.1849596,17.8240826 C4.60179277,16.2409218 4.60179277,13.6807396 6.18134874,12.1011843 L12.4395893,5.8770467 C13.6049179,4.71807195 15.4883496,4.72064626 16.6505056,5.88280226 C17.8123042,7.04460086 17.8125519,8.92817214 16.651059,10.0902763 L10.2949559,16.4497244 C9.54331608,17.2017597 8.32434648,17.2020804 7.57226458,16.4503941 C6.81988433,15.6980139 6.81780588,14.4793123 7.56730486,13.7246829 L12.1291989,9.13156162 C12.3237939,8.93563459 12.6403745,8.93455475 12.8363015,9.12914974 C13.0322286,9.32374472 13.0333084,9.64032537 12.8387134,9.83625241 L8.27681941,14.4293736 C7.91557205,14.7930938 7.91657383,15.3804899 8.27901321,15.7429292 C8.64064021,16.1043661 9.22644486,16.104212 9.58766315,15.7428036 L15.9437662,9.38335557 C16.7149102,8.61180574 16.7147457,7.36125599 15.9433988,6.58990904 C15.1710124,5.81752267 13.9192554,5.81581175 13.1447605,6.58608381 L6.89434715,12.8024168 C5.69942385,13.9973221 5.69942385,15.9243393 6.88770251,17.1126181 C8.0832935,18.3045772 10.013025,18.3016371 11.2014339,17.1096014 L17.1459084,11.1469857 Z" />
                                </Viewbox>
                            </Button.Content>
                        </Button>

                        <Border Grid.Column="1"
                                Style="{StaticResource ChatInputBorderStyle}">
                            <TextBox x:Name="MessageTextBox"
                                     Style="{StaticResource MessageInputTextBoxStyle}"
                                     FontSize="16"
                                     HorizontalContentAlignment="Left"
                                     TextAlignment="Left"
                                     Padding="12,0,12,0"
                                     MinHeight="50"
                                     MaxHeight="100"
                                     Text="Message..."
                                     Foreground="{DynamicResource ThemePrimaryBrush}"
                                     FontStyle="Italic"
                                     AcceptsReturn="True"
                                     PreviewKeyDown="MessageTextBox_PreviewKeyDown"
                                     TextChanged="MessageTextBox_TextChanged"
                                     VerticalScrollBarVisibility="Hidden"
                                     HorizontalScrollBarVisibility="Disabled" />
                        </Border>

                        <Button x:Name="SendButton"
                                Grid.Column="2"
                                Style="{StaticResource PageChatActionButtonStyle}"
                                FontSize="20"
                                HorizontalAlignment="Right"
                                Margin="0,10,10,10"
                                Click="SendButton_Click">
                            <Button.Content>
                                <Viewbox Width="24" Height="24">
                                    <Path Fill="{DynamicResource ThemePrimaryBrush}"
                                          Data="M11.5003 12H5.41872M5.24634 12.7972L4.24158 15.7986C3.69128 17.4424 3.41613 18.2643 3.61359 18.7704C3.78506 19.21 4.15335 19.5432 4.6078 19.6701C5.13111 19.8161 5.92151 19.4604 7.50231 18.7491L17.6367 14.1886C19.1797 13.4942 19.9512 13.1471 20.1896 12.6648C20.3968 12.2458 20.3968 11.7541 20.1896 11.3351C19.9512 10.8529 19.1797 10.5057 17.6367 9.81135L7.48483 5.24303C5.90879 4.53382 5.12078 4.17921 4.59799 4.32468C4.14397 4.45101 3.77572 4.78336 3.60365 5.22209C3.40551 5.72728 3.67772 6.54741 4.22215 8.18767L5.24829 11.2793C5.34179 11.561 5.38855 11.7019 5.407 11.8459C5.42338 11.9738 5.42321 12.1032 5.40651 12.231C5.38768 12.375 5.34057 12.5157 5.24634 12.7972Z" />
                                </Viewbox>
                            </Button.Content>
                        </Button>

                        <Button x:Name="StickerButton"
                                Grid.Column="3"
                                Style="{StaticResource PageChatActionButtonStyle}"
                                FontSize="20"
                                HorizontalAlignment="Right"
                                Click="StickerButton_Click">
                            <Button.Content>
                                <Viewbox Width="24" Height="24">
                                    <Path Fill="{DynamicResource ThemePrimaryBrush}"
                                          Data="M20,11.5 L20,7.5 C20,5.56700338 18.4329966,4 16.5,4 L7.5,4 C5.56700338,4 4,5.56700338 4,7.5 L4,16.5 C4,18.4329966 5.56700338,20 7.5,20 L12.5,20 C13.3284271,20 14,19.3284271 14,18.5 L14,16.5 C14,14.5670034 15.5670034,13 17.5,13 L18.5,13 C19.3284271,13 20,12.3284271 20,11.5 Z M19.9266247,13.5532532 C19.522053,13.8348821 19.0303092,14 18.5,14 L17.5,14 C16.1192881,14 15,15.1192881 15,16.5 L15,18.5 C15,18.9222858 14.8952995,19.3201175 14.7104416,19.668952 C17.4490113,18.8255402 19.5186665,16.4560464 19.9266247,13.5532532 L19.9266247,13.5532532 Z M7.5,3 L16.5,3 C18.9852814,3 21,5.01471863 21,7.5 L21,12.5 C21,17.1944204 17.1944204,21 12.5,21 L7.5,21 C5.01471863,21 3,18.9852814 3,16.5 L3,7.5 C3,5.01471863 5.01471863,3 7.5,3 Z" />
                                </Viewbox>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Rectangle x:Name="Overlay"
                   Grid.ColumnSpan="2"
                   Fill="{DynamicResource ThemeOverlayBrush}"
                   Visibility="Collapsed"
                   MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                   Panel.ZIndex="900" />

        <Border x:Name="SideMenu"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="293"
                Height="500"
                Background="{DynamicResource ThemeSurfaceBrush}"
                CornerRadius="0,0,40,40"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="15,0,0,0"
                Padding="0"
                RenderTransformOrigin="0.5,0.5"
                Panel.ZIndex="1000"
                Effect="{StaticResource FloatingPanelShadowEffect}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SideMenuTransform" X="-350" />
            </Border.RenderTransform>

            <StackPanel Margin="20,0,20,0"
                        HorizontalAlignment="Stretch">
                <TextBlock x:Name="MenuTitleText"
                           Style="{StaticResource PanelTitleTextStyle}"
                           Text="Menu"
                           Margin="15,40,0,20"
                           HorizontalAlignment="Left" />

                <Button x:Name="SettingsButton"
                        Style="{StaticResource SideMenuButtonStyle}"
                        Content="⚙️ Settings"
                        Click="SettingsButton_Click" />

                <Button x:Name="PremiumButton"
                        Style="{StaticResource SideMenuButtonStyle}"
                        Content="👑 Premium"
                        Click="PremiumButton_Click" />

                <Button x:Name="HelpButton"
                        Style="{StaticResource SideMenuButtonStyle}"
                        Content="❓ About the app"
                        Click="AboutApp_Click" />

                <Button x:Name="LogoutButton"
                        Style="{StaticResource SideMenuButtonStyle}"
                        Content="🚪 Logout"
                        Foreground="{DynamicResource ThemeDangerBrush}"
                        Click="LogoutButton_Click" />

                <Image Source="/Assets/PageIllustrations/menu-panel.png"
                       Stretch="Fill"
                       RenderTransformOrigin="0.494,0.023"
                       Height="451"
                       Width="282"
                       Margin="0,-48,0,0"
                       IsHitTestVisible="False" />
            </StackPanel>
        </Border>

        <Border x:Name="ContactInfoPanel"
                Grid.Column="1"
                Style="{StaticResource PageFloatingPanelStyle}"
                Width="400"
                Height="650"
                CornerRadius="40,0,0,40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,41,0,0"
                Panel.ZIndex="1001"
                BorderThickness="1,1,0,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ContactInfoTransform" X="400" />
            </Border.RenderTransform>

            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ContactInfoTitle"
                                   Grid.Column="0"
                                   Style="{StaticResource PanelTitleTextStyle}"
                                   Text="Contact Information" />

                        <Button x:Name="EditContactButton"
                                Grid.Column="1"
                                Style="{StaticResource SmallIconButtonStyle}"
                                Content="✎"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                FontSize="16"
                                Click="EditContactButton_Click"
                                ToolTip="Edit contact"
                                Visibility="Visible" />
                    </Grid>

                    <Border x:Name="ContactPhotoBorder"
                            Grid.Row="1"
                            Width="120"
                            Height="120"
                            CornerRadius="60"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,25"
                            BorderBrush="{DynamicResource ThemeSecondaryBrush}"
                            BorderThickness="3">
                        <Border.Background>
                            <ImageBrush x:Name="ContactPhotoBackground"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <StackPanel Grid.Row="2"
                                Orientation="Vertical"
                                Margin="15,0">
                        <TextBlock x:Name="DisplayNameLabelText"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="Name"
                                   Margin="0,10,0,5" />

                        <Border Style="{StaticResource InfoValueBorderStyle}">
                            <TextBlock x:Name="ContactInfoName"
                                       Style="{StaticResource InfoValueTextStyle}"
                                       Text=""
                                       MouseDown="ContactInfoText_MouseDown"
                                       Cursor="IBeam" />
                        </Border>

                        <TextBlock x:Name="UsernameLabelText"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="User Name" />

                        <Border Style="{StaticResource InfoValueBorderStyle}">
                            <TextBlock x:Name="ContactInfoUsername"
                                       Style="{StaticResource InfoValueTextStyle}"
                                       Text=""
                                       MouseDown="ContactInfoText_MouseDown"
                                       Cursor="IBeam" />
                        </Border>

                        <TextBlock x:Name="FirstNameLabelText"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="First Name" />

                        <Border Style="{StaticResource InfoValueBorderStyle}">
                            <TextBlock x:Name="ContactInfoFirstName"
                                       Style="{StaticResource InfoValueTextStyle}"
                                       Text=""
                                       MouseDown="ContactInfoText_MouseDown"
                                       Cursor="IBeam" />
                        </Border>

                        <TextBlock x:Name="LastNameLabelText"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="Last Name" />

                        <Border Style="{StaticResource InfoValueBorderStyle}">
                            <TextBlock x:Name="ContactInfoLastName"
                                       Style="{StaticResource InfoValueTextStyle}"
                                       Text=""
                                       MouseDown="ContactInfoText_MouseDown"
                                       Cursor="IBeam" />
                        </Border>

                        <TextBlock x:Name="EmailLabelText"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="Email" />

                        <Border Style="{StaticResource InfoValueBorderStyle}">
                            <TextBlock x:Name="ContactInfoEmail"
                                       Style="{StaticResource InfoValueTextStyle}"
                                       Text=""
                                       MouseDown="ContactInfoText_MouseDown"
                                       Cursor="IBeam" />
                        </Border>

                        <TextBlock x:Name="PhoneLabelText"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="Phone" />

                        <Border Style="{StaticResource InfoValueBorderStyle}"
                                Margin="0,0,0,20">
                            <TextBlock x:Name="ContactInfoPhone"
                                       Style="{StaticResource InfoValueTextStyle}"
                                       Text=""
                                       MouseDown="ContactInfoText_MouseDown"
                                       Cursor="IBeam" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Orientation="Vertical"
                                Margin="15,0">
                        <TextBlock x:Name="PersonalNotesTitle"
                                   Style="{StaticResource BodyBoldTextStyle}"
                                   Text="Personal Notes"
                                   FontSize="16"
                                   Margin="0,0,0,10" />

                        <TextBlock x:Name="PersonalNotesPrivate"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   Text="*only you can see this information"
                                   FontStyle="Italic"
                                   Opacity="0.7"
                                   Margin="0,0,0,10" />

                        <Border x:Name="Note1Border" Style="{StaticResource CollapsedNoteBorderStyle}">
                            <TextBlock x:Name="ContactInfoNote1"
                                       Style="{StaticResource NoteValueTextStyle}"
                                       Text="" />
                        </Border>

                        <TextBlock x:Name="NoNotesText"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="No notes added yet"
                                   FontStyle="Italic"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,12"
                                   Visibility="Visible" />

                        <Border Style="{StaticResource InfoValueBorderStyle}"
                                Margin="0,0,0,10">
                            <TextBox x:Name="ContactNoteEditor"
                                     Style="{StaticResource MultilineTextBoxStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="110"
                                     BorderThickness="0"
                                     Background="Transparent" />
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,8">
                            <Button x:Name="DeleteContactNoteButton"
                                    Style="{StaticResource DeleteNoteButtonStyle}"
                                    Content="Delete"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="DeleteContactNoteButton_Click" />

                            <Button x:Name="SaveContactNoteButton"
                                    Style="{StaticResource AddNoteButtonStyle}"
                                    Content="Add Note"
                                    Click="SaveContactNoteButton_Click" />
                        </StackPanel>

                        <TextBlock x:Name="ContactNoteLimitWarning"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   Foreground="{DynamicResource ThemeDangerBrush}"
                                   Margin="0,4,0,0"
                                   Text=""
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <Button x:Name="CloseContactInfoButton"
                            Grid.Row="4"
                            Style="{StaticResource PrimaryDialogButtonStyle}"
                            Content="Close"
                            FontSize="16"
                            Width="120"
                            HorizontalAlignment="Center"
                            Click="CloseContactInfo_Click"
                            Margin="0,15,0,0" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Border x:Name="StickersPanel"
                Grid.Column="1"
                Style="{StaticResource PageFloatingPanelStyle}"
                Width="360"
                Height="250"
                CornerRadius="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,80"
                Panel.ZIndex="1005"
                Effect="{StaticResource PopupShadowEffect}">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="StickersTitle"
                               Style="{StaticResource BodyBoldTextStyle}"
                               Text="Stickers"
                               FontSize="16"
                               Foreground="{DynamicResource ThemePrimaryBrush}"
                               VerticalAlignment="Center" />

                    <Button x:Name="CloseStickersButton"
                            Style="{StaticResource TransparentIconButtonStyle}"
                            HorizontalAlignment="Right"
                            Content="✕"
                            Foreground="{DynamicResource ThemePrimaryBrush}"
                            FontWeight="Bold"
                            Click="CloseStickers_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                    <UniformGrid x:Name="StickersGrid"
                                 Columns="4"
                                 HorizontalAlignment="Center" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="GroupInfoPanel"
                Grid.Column="1"
                Style="{StaticResource PageFloatingPanelStyle}"
                Width="400"
                Height="600"
                CornerRadius="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,41,0,0"
                Panel.ZIndex="1001">
            <Border.RenderTransform>
                <TranslateTransform x:Name="GroupInfoTransform" X="400" />
            </Border.RenderTransform>

            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel Margin="25">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="GroupInfoTitle"
                                   Grid.Column="0"
                                   Style="{StaticResource PanelTitleTextStyle}"
                                   Text="Group Info" />

                        <Button x:Name="GroupSettingsIconButton"
                                Grid.Column="1"
                                Style="{StaticResource SmallIconButtonStyle}"
                                Content="⚙️"
                                Foreground="{DynamicResource ThemePrimaryBrush}"
                                FontSize="18"
                                Click="GroupSettingsButton_Click"
                                ToolTip="Group Settings"
                                Visibility="Collapsed" />
                    </Grid>

                    <Border x:Name="GroupPhotoBorder"
                            Width="100"
                            Height="100"
                            CornerRadius="50"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"
                            BorderBrush="{DynamicResource ThemePrimaryBrush}"
                            BorderThickness="3">
                        <Border.Background>
                            <ImageBrush x:Name="GroupPhotoBackground"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <Border Style="{StaticResource InfoValueBorderStyle}"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock x:Name="GroupNameLabelText"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       Text="Group Name"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5" />

                            <TextBlock x:Name="GroupInfoNameText"
                                       Style="{StaticResource InfoValueTextStyle}"
                                       Text="Loading..."
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InfoValueBorderStyle}"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock x:Name="DescriptionLabelText"
                                       Style="{StaticResource SmallMutedTextStyle}"
                                       Text="Description"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5" />

                            <StackPanel x:Name="GroupDescriptionPanel">
                                <TextBlock x:Name="GroupInfoDescriptionText"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text=""
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="NoDescriptionText"
                                           Style="{StaticResource SmallMutedTextStyle}"
                                           Text="No description"
                                           FontStyle="Italic"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="MembersLabelText"
                               Style="{StaticResource BodyBoldTextStyle}"
                               Text="Members"
                               FontSize="14"
                               Margin="0,0,0,10" />

                    <Border Background="{DynamicResource ThemeSurfaceAltBrush}"
                            CornerRadius="10"
                            Padding="0"
                            Margin="0,0,0,20"
                            MinHeight="100"
                            MaxHeight="250">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="GroupMembersPanel" Margin="10" />
                        </ScrollViewer>
                    </Border>

                    <Button x:Name="CloseGroupInfoButton"
                            Style="{StaticResource SecondaryDialogButtonStyle}"
                            Content="Close"
                            HorizontalAlignment="Stretch"
                            Click="CloseGroupInfo_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Rectangle x:Name="GroupInfoOverlay"
                   Grid.ColumnSpan="2"
                   Fill="{DynamicResource ThemeOverlayBrush}"
                   Visibility="Collapsed"
                   MouseLeftButtonDown="GroupInfoOverlay_MouseLeftButtonDown"
                   Panel.ZIndex="1000" />

        <Border x:Name="SearchResultsBorder"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                Background="{DynamicResource ThemeSurfaceBrush}"
                CornerRadius="15"
                Width="300"
                MaxHeight="400"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="92,95,0,0"
                Panel.ZIndex="2000"
                BorderBrush="{DynamicResource ThemePrimaryBrush}"
                BorderThickness="2"
                Effect="{StaticResource PopupShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="{DynamicResource ThemeSecondaryBrush}"
                      Height="45">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SearchResultsTitle"
                               Grid.Column="0"
                               Text="Search Results"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeOnSecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0" />

                    <Button Grid.Column="1"
                            Style="{StaticResource TransparentIconButtonStyle}"
                            Content="✕"
                            Width="35"
                            Height="35"
                            Foreground="{DynamicResource ThemeOnSecondaryTextBrush}"
                            FontSize="18"
                            FontWeight="Bold"
                            Click="CloseSearchResults_Click"
                            Margin="0,0,5,0" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              Padding="10"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                    <StackPanel x:Name="SearchResultsPanel"
                                Orientation="Vertical" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="CreateGroupDialog"
                Grid.ColumnSpan="2"
                Style="{StaticResource PageDialogPanelStyle}"
                Width="500"
                MaxHeight="600"
                BorderThickness="2">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="CreateGroupTitle"
                           Grid.Row="0"
                           Style="{StaticResource DialogTitleTextStyle}"
                           Text="Create New Group"
                           FontSize="22"
                           Margin="0,0,0,20" />

                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock x:Name="GroupNameInputLabel"
                               Style="{StaticResource FieldLabelTextStyle}"
                               Text="Group Name"
                               Margin="0,0,0,5" />

                    <TextBox x:Name="GroupNameTextBox"
                             Style="{StaticResource GroupNameTextBoxStyle}"
                             FontSize="16"
                             MaxLength="50" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="AddParticipantsLabel"
                                   Grid.Column="0"
                                   Style="{StaticResource FieldLabelTextStyle}"
                                   Text="Add Participants"
                                   Margin="0" />

                        <TextBlock x:Name="ParticipantCountText"
                                   Grid.Column="1"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   Text="(0 selected)"
                                   Margin="5,0,0,0" />
                    </Grid>

                    <TextBox x:Name="ParticipantSearchTextBox"
                             Style="{StaticResource DialogTextBoxStyle}"
                             Height="35"
                             FontSize="14"
                             Padding="10,0,10,0"
                             HorizontalContentAlignment="Left"
                             TextAlignment="Left"
                             TextChanged="ParticipantSearchTextBox_TextChanged"
                             GotFocus="ParticipantSearchTextBox_GotFocus"
                             LostFocus="ParticipantSearchTextBox_LostFocus"
                             Margin="0,0,0,10" />

                    <ScrollViewer MaxHeight="250"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                        <StackPanel x:Name="ParticipantsPanel"
                                    HorizontalAlignment="Stretch"
                                    Orientation="Vertical" />
                    </ScrollViewer>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelCreateGroupButton"
                            Grid.Column="0"
                            Style="{StaticResource SecondaryDialogButtonStyle}"
                            Content="Cancel"
                            Margin="0,0,5,0"
                            Click="CancelCreateGroup_Click" />

                    <Button x:Name="ConfirmCreateGroupButton"
                            Grid.Column="1"
                            Style="{StaticResource PrimaryDialogButtonStyle}"
                            Content="Create Group"
                            Margin="5,0,0,0"
                            Click="ConfirmCreateGroup_Click" />
                </Grid>
            </Grid>
        </Border>

        <Rectangle x:Name="CreateGroupOverlay"
                   Grid.ColumnSpan="2"
                   Fill="{DynamicResource ThemeOverlayBrush}"
                   Visibility="Collapsed"
                   MouseLeftButtonDown="CreateGroupOverlay_MouseLeftButtonDown"
                   Panel.ZIndex="1999" />

        <Rectangle x:Name="ContactInfoOverlay"
                   Grid.ColumnSpan="2"
                   Fill="{DynamicResource ThemeOverlayBrush}"
                   Visibility="Collapsed"
                   MouseLeftButtonDown="ContactInfoOverlay_MouseLeftButtonDown"
                   Panel.ZIndex="1000" />
    </Grid>
</common:ThemedPage>
