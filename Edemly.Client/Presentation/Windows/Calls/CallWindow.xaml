<common:ThemedWindow x:Class="Edemly.Client.Presentation.Windows.Calls.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
        Title="Calls"
        Height="420"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="CallOverlayPanelStyle"
               TargetType="Border"
               BasedOn="{StaticResource CallOverlayPanelBorderStyle}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Panel.ZIndex" Value="9000" />
            <Setter Property="Effect" Value="{StaticResource CallPanelShadowEffect}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Margin="8">

        <Border x:Name="NotificationBorder"
                Background="{DynamicResource ThemeBackgroundDarkBrush}"
                CornerRadius="8"
                Padding="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="8"
                Visibility="Collapsed"
                Panel.ZIndex="9500">

            <TextBlock x:Name="NotificationText"
                       Foreground="{DynamicResource ThemeOnPrimaryTextBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <Border x:Name="IncomingPrompt"
                Style="{StaticResource CallOverlayPanelStyle}"
                Background="{DynamicResource ThemeSecondaryBrush}">

            <StackPanel Orientation="Horizontal"
                        Width="420">

                <Border Width="56"
                        Height="56"
                        CornerRadius="28"
                        BorderBrush="{DynamicResource ThemeOnSecondaryTextBrush}"
                        BorderThickness="2"
                        Margin="0,0,8,0">

                    <Image x:Name="IncomingAvatar"
                           Stretch="UniformToFill" />
                </Border>

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center"
                            Width="280">

                    <TextBlock x:Name="IncomingText"
                               Text="Incoming call"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ThemeOnSecondaryTextBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="IncomingFromText"
                               Text="From: "
                               Foreground="{DynamicResource ThemeOnSecondaryTextBrush}"
                               Margin="0,6,0,8" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="AcceptIncomingButton"
                                Style="{StaticResource LightButtonStyle}"
                                Content="Accept"
                                Width="80"
                                Height="36"
                                Margin="4"
                                Padding="14,0"
                                Click="AcceptIncomingButton_Click" />

                        <Button x:Name="RejectIncomingButton"
                                Style="{StaticResource DangerButtonStyle}"
                                Content="Reject"
                                Width="80"
                                Height="36"
                                Margin="4"
                                Padding="14,0"
                                Click="RejectIncomingButton_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="DialingPanel"
                Style="{StaticResource CallOverlayPanelStyle}"
                Background="{DynamicResource ThemeBackgroundDarkBrush}">

            <StackPanel Orientation="Vertical"
                        Width="420">

                <TextBlock x:Name="DialingText"
                           Text="Calling..."
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ThemeOnPrimaryTextBrush}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="DialingCountdown"
                           Text="30s"
                           Foreground="{DynamicResource ThemeOnPrimaryTextBrush}"
                           Margin="0,8,0,8" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="CancelCallButton"
                            Style="{StaticResource LightButtonStyle}"
                            Content="Cancel"
                            Width="80"
                            Height="36"
                            Margin="4"
                            Padding="14,0"
                            Click="CancelCallButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="CallViewGrid"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="8,8,8,4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Vertical">

                    <TextBlock x:Name="CallTitle"
                               Style="{StaticResource CallSectionTitleStyle}"
                               Text="Call" />

                    <TextBlock x:Name="CallInfoText"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="CallDurationText"
                               Text="00:00"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               HorizontalAlignment="Right" />

                    <TextBlock x:Name="CallMediaKindText"
                               Text="Audio"
                               FontSize="11"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="8">

                <Border x:Name="DirectCallPanel"
                        CornerRadius="18"
                        Padding="24"
                        Background="{DynamicResource ThemeSurfaceAltBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                        BorderThickness="1">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.RowSpan="2"
                                Opacity="0.18"
                                CornerRadius="16"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF243447" Offset="0" />
                                    <GradientStop Color="#FF52656D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <StackPanel Grid.Row="0"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Border x:Name="DirectAvatarBorder"
                                    Width="128"
                                    Height="128"
                                    CornerRadius="64"
                                    BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                    BorderThickness="3"
                                    Background="{DynamicResource ThemeBorderLightBrush}">

                                <Image x:Name="DirectAvatarImage"
                                       Stretch="UniformToFill" />
                            </Border>

                            <TextBlock x:Name="DirectParticipantNameText"
                                       Text="Participant"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="320"
                                       Margin="0,16,0,0" />

                            <TextBlock x:Name="DirectParticipantStatusText"
                                       Text="Connected"
                                       FontSize="13"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                CornerRadius="14"
                                Padding="12,7"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource ThemeSurfaceBrush}"
                                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                BorderThickness="1">

                            <TextBlock x:Name="DirectMicStatusText"
                                       Text="Mic on"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="GroupCallPanel"
                        Visibility="Collapsed"
                        CornerRadius="18"
                        Padding="14"
                        Background="{DynamicResource ThemeBackgroundDarkBrush}"
                        BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                        BorderThickness="1">

                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="GroupParticipantsPanel"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="8">

                <Button x:Name="MuteButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Mute"
                        Width="80"
                        Height="36"
                        Margin="6"
                        Padding="14,0"
                        Click="MuteButton_Click" />

                <Button x:Name="EndCallButton"
                        Style="{StaticResource DangerButtonStyle}"
                        Content="End"
                        Width="80"
                        Height="36"
                        Margin="6"
                        Padding="14,0"
                        Click="EndCallButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</common:ThemedWindow>
