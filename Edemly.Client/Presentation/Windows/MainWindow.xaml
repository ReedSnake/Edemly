<common:ThemedWindow x:Class="Edemly.Client.Presentation.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Edemly.Client.Presentation.Controls"
        xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
        Title="Edemly" Height="768" Width="1300"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Branding/app-icon.ico"
        Background="{DynamicResource PageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ConnectionStatusBar x:Name="ConnectionStatusBar" Grid.Row="0" HorizontalAlignment="Stretch" Panel.ZIndex="100" />

        <Frame x:Name="MainFrame"
             Grid.Row="1"
             NavigationUIVisibility="Hidden" />
    </Grid>
</common:ThemedWindow>
