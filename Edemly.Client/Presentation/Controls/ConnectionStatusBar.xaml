<common:ThemedUserControl x:Class="Edemly.Client.Presentation.Controls.ConnectionStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Edemly.Client.Presentation.Common"
             x:Name="RootControl"
             Visibility="Visible">
    <Border x:Name="StatusBorder"
            MinHeight="35"
            Background="{DynamicResource ThemeSurfaceAltBrush}"
            Visibility="Collapsed">
        <Grid Margin="12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="StatusSpinnerHost"
                  Grid.Column="0"
                  Width="16"
                  Height="16"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center">
                <Ellipse x:Name="StatusSpinner"
                         Width="16"
                         Height="16"
                         Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                         StrokeThickness="2"
                         StrokeDashArray="12,12">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="8" CenterY="8" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                   Storyboard.TargetProperty="Angle"
                                                   From="0" To="360" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Text="Reconnecting to server..."
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <StackPanel x:Name="UpdateActionsPanel"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Button x:Name="UpdateNowButton"
                        MinWidth="92"
                        Height="24"
                        Margin="0,0,8,0"
                        Padding="10,0"
                        Content="Update now"
                        Click="UpdateNowButton_Click" />
                <Button x:Name="RemindLaterButton"
                        MinWidth="92"
                        Height="24"
                        Padding="10,0"
                        Content="Remind later"
                        Click="RemindLaterButton_Click" />
            </StackPanel>

            <Button x:Name="DismissButton"
                    Grid.Column="3"
                    Width="24"
                    Height="24"
                    Margin="8,0,0,0"
                    Padding="0"
                    Content="X"
                    ToolTip="Hide"
                    Visibility="Collapsed"
                    Click="DismissButton_Click" />
        </Grid>
    </Border>
</common:ThemedUserControl>
